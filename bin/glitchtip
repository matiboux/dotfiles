#!/usr/bin/env python3
"""Read-only GlitchTip client: pass a GlitchTip web URL, get the matching data printed on stdout.

Nothing is ever written to disk (except the stored API key, see `login`).
Standard library only.
"""

import argparse
import getpass
import json
import os
import re
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = os.environ.get("GLITCHTIP_URL", "https://glitchtip.matiboux.com")
CONFIG_DIR = os.environ.get("GLITCHTIP_CONFIG_DIR") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "glitchtip"
)

HELP = f"""\
Usage: glitchtip <url> [options]

  glitchtip <base_url>                      list organizations
  glitchtip <base_url>/<org>/projects       list projects of an organization
  glitchtip <base_url>/<org>/issues         list issues (query args: project, environment, sort, query)
  glitchtip <base_url>/<org>/issues/<id>    print one issue ("Copy for AI" format)

Where:
  <base_url>  your GlitchTip instance, e.g. {DEFAULT_URL} (https:// is optional)
  <org>       organization slug, the first path segment in the web UI URL
              (run `glitchtip <base_url>` to list them)
  <id>        issue number, as in <base_url>/<org>/issues/<id>

Issues list query args (as in the web UI URL; project can be repeated):
  ?project=5&project=6&environment=prod&sort=-last_seen&query=is:resolved

Tip: copy a URL straight from the browser address bar.

Options:
  --json          print the raw API JSON instead of the text rendering
  --limit N       max items for lists (default 25)
  --status S      issues list: unresolved (default), resolved, ignored or all
  --query Q       issues list: raw GlitchTip search query (overrides --status)

Authentication (API key = GlitchTip auth token with the "event:read" scope,
created in Profile > Auth Tokens). The key is never printed and never passed as an argument:
  glitchtip login [<base_url>]     prompt for the key (hidden) and store it for that host
  glitchtip logout [<base_url>]    forget the stored key
Key lookup order: $GLITCHTIP_API_KEY, $GLITCHTIP_API_KEY_FILE, {CONFIG_DIR}/<host of base_url>
Override the directory with $GLITCHTIP_CONFIG_DIR (e.g. a read-only mount in a devcontainer).
"""


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def normalize(url):
    if "://" not in url:
        url = "https://" + url
    return urllib.parse.urlsplit(url)


def host_of(url):
    return normalize(url).netloc


def token_path(host):
    return os.path.join(CONFIG_DIR, re.sub(r"[^A-Za-z0-9._-]", "_", host))


def load_token(host):
    if os.environ.get("GLITCHTIP_API_KEY"):
        return os.environ["GLITCHTIP_API_KEY"].strip()
    path = os.environ.get("GLITCHTIP_API_KEY_FILE") or token_path(host)
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return None


def login(url):
    host = host_of(url)
    if sys.stdin.isatty():
        token = getpass.getpass(f"API key for {host} (hidden): ")
    else:
        token = sys.stdin.readline()
    token = token.strip()
    if not token:
        die("No key given.")
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    os.chmod(CONFIG_DIR, 0o700)
    path = token_path(host)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, stat.S_IRUSR | stat.S_IWUSR)
    with os.fdopen(fd, "w") as f:
        f.write(token + "\n")
    os.chmod(path, 0o600)
    print(f"Key for {host} stored in {path} (mode 600).")


def logout(url):
    path = token_path(host_of(url))
    try:
        os.remove(path)
        print(f"Removed {path}")
    except FileNotFoundError:
        die(f"No stored key for {host_of(url)}.")


def get(base, path, token, params=None):
    url = base + path
    if params:
        url += "?" + urllib.parse.urlencode(params, doseq=True)
    return get_url(url, token)


def get_url(url, token):
    req = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
            # Cloudflare (error 1010) blocks urllib's default "Python-urllib" agent.
            "User-Agent": "glitchtip-cli/1.0",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as res:
            return json.load(res), res.headers
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None, {}
        hint = ""
        if e.code in (401, 403):
            hint = f"\nCheck the API key (scope: event:read). Run: glitchtip login {urllib.parse.urlsplit(url).netloc}"
        die(f"HTTP {e.code} on {url}: {e.read().decode(errors='replace')[:300]}{hint}")
    except urllib.error.URLError as e:
        die(f"Cannot reach {url}: {e.reason}")


def paginate(base, path, token, params, limit):
    """Follow the Sentry-style `Link: <...>; rel="next"; results="true"` header, up to `limit` items."""
    out = []
    data, headers = get(base, path, token, params)
    while True:
        if data is None:
            die("Not found.")
        out.extend(data)
        if len(out) >= limit:
            return out[:limit]
        nxt = None
        for part in (headers.get("Link") or "").split(","):
            if 'rel="next"' in part and 'results="true"' in part:
                m = re.search(r"<([^>]+)>", part)
                nxt = m.group(1) if m else None
        if not nxt:
            return out
        data, headers = get_url(nxt, token)


def render_issue(base, org, issue, event, projects):
    """Same text as GlitchTip's "Copy for AI" button: a header, then the raw event JSON."""
    event = event or issue  # no event stored for this issue: dump the issue itself
    query = "&".join(f"project={p}" for p in projects)
    url = f"{base}/{org}/issues/{issue['id']}" + (f"?{query}" if query else "")
    header = [
        "GlitchTip error event",
        f"Source: {base}",
        f"Instance: {base}",
        f"Organization: {org}",
        f"Issue ID: {issue['id']}",
        f"Event ID: {event.get('id')}",
        f"Event URL: {url}",
    ]
    raw = json.dumps(event, indent=2, ensure_ascii=False)
    return "\n".join(header) + "\n\nRaw event JSON:\n```json\n" + raw + "\n```"


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("login", "logout"):
        (login if argv[0] == "login" else logout)(argv[1] if len(argv) > 1 else DEFAULT_URL)
        return

    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("url", nargs="?")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--limit", type=int, default=25)
    ap.add_argument("--status", default="unresolved")
    ap.add_argument("--query")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args(argv)
    if args.help:
        print(HELP)
        return
    if not args.url:
        print(HELP, file=sys.stderr)
        sys.exit(1)

    u = normalize(args.url)
    base = f"{u.scheme}://{u.netloc}"
    parts = [p for p in u.path.split("/") if p]
    url_params = urllib.parse.parse_qs(u.query)

    token = load_token(u.netloc)
    if not token:
        die(f"No API key for {u.netloc}. Run: glitchtip login {u.netloc}\n(or set GLITCHTIP_API_KEY / GLITCHTIP_API_KEY_FILE)")

    def emit(data, lines):
        if args.json:
            print(json.dumps(data, indent=2, ensure_ascii=False))
        else:
            print("\n".join(lines))

    if not parts:
        orgs = paginate(base, "/api/0/organizations/", token, None, args.limit)
        if not orgs:
            print(HELP, file=sys.stderr)
            die("No organizations found for this key.")
        emit(orgs, [f"{o['slug']}\t{o.get('name', '')}\t{base}/{o['slug']}/projects" for o in orgs])
        return

    org, kind = parts[0], (parts[1] if len(parts) > 1 else "projects")

    if kind == "projects" and len(parts) <= 2:
        projects = paginate(base, f"/api/0/organizations/{org}/projects/", token, None, args.limit)
        emit(projects, [f"{p['id']}\t{p['slug']}\t{p.get('platform') or ''}" for p in projects])
    elif kind == "issues" and len(parts) == 2:
        params = {k: v for k, v in url_params.items() if k in ("project", "environment", "sort")}
        query = args.query or (url_params.get("query") or [None])[0]
        if query is None:
            query = "" if args.status == "all" else f"is:{args.status}"
        params["query"] = query
        issues = paginate(base, f"/api/0/organizations/{org}/issues/", token, params, args.limit)
        emit(issues, [
            f"{i['id']}\t{i.get('status', '')}\t{i.get('count', '')}x\t{(i.get('project') or {}).get('slug', '')}\t{i['title']}"
            for i in issues
        ])
    elif kind == "issues" and len(parts) == 3:
        issue_id = parts[2]
        issue, _ = get(base, f"/api/0/issues/{issue_id}/", token)
        if issue is None:
            die(f"Issue {issue_id} not found.")
        event, _ = get(base, f"/api/0/issues/{issue_id}/events/latest/", token)
        if args.json:
            print(json.dumps({"issue": issue, "event": event}, indent=2, ensure_ascii=False))
        else:
            print(render_issue(base, org, issue, event, url_params.get("project", [])))
    else:
        print(HELP, file=sys.stderr)
        die(f"Unsupported URL path: {u.path}")


if __name__ == "__main__":
    main()
