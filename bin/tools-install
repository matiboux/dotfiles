#!/bin/sh
# Install or update common command-line tools.
# Supports Linux (apt or dnf) and macOS (Homebrew).
#
# Usage: tools-install [-a|--all] [-f|--force] [-l|--list] [-n|--dry-run]
#                      [-v|--verbose] [-h|--help] [TOOL|@GROUP...]
#
# The output of the commands (apt, downloads...) is hidden, and only shown when
# one fails, or with --verbose. Each tool gets a one-line result. sudo is asked
# once at the start, only if a tool needs root.
#
# Without arguments, a menu lists the tools with their status, to tick or untick
# (arrow keys and space) before running. Without a terminal, it only lists them.
#
# Groups, to install a set of tools at once:
# - @base: git curl wget unzip zip tree htop jq yq shellcheck.
# - @git: gh glab.
# - @docker: lazydocker dockerc dockerx. These need docker: if it is not
#   installed, add docker to the command or it fails (in the menu, they can't be
#   ticked until docker is installed or ticked).
# A group only installs what is missing: a tool that is already there is left
# alone (no update), and a failure never changes the exit status. That makes it
# safe to run again and again, from a bootstrap script for example. Name a tool
# explicitly to update it.
#
# Tools:
# - system packages, installed through apt, dnf or brew: git curl wget unzip
#   tree htop zip rsync rclone ripgrep fzf ncdu tmux fd bat jq shellcheck
#   On apt, fd and bat are named fdfind and batcat: they are linked as fd and
#   bat in ~/.local/bin when those names are free.
# - docker: the official convenience script on Linux (apt and dnf packages
#   after that), the Docker Desktop cask on macOS.
# - binaries downloaded from their official releases on Linux (Homebrew on
#   macOS): gh glab yq lazydocker 7zip (the official 7-Zip, command 7zz,
#   also linked as 7z when that name is free).
# - dockerc dockerx: the scripts of their GitHub releases, on Linux and macOS.
#
# Where things go:
# - The binaries we download go to ~/.local/bin (no root needed), each recorded
#   in ~/.local/state/tools-install/<tool>. That record is how we know we manage
#   a binary, and can update it.
# - System packages need root (sudo).
#
# What happens for each tool, depending on where its command is found:
# - Not installed: install it.
# - Installed by us: update it, unless it is already at the latest release.
# - Installed by apt, dnf or brew: update it through that package manager.
# - Anything else (manual install, other tool manager, Docker Desktop...): skipped,
#   it is not ours to touch. The same goes for a file in ~/.local/bin that we
#   have no record of.
# - With --force, those last two are taken over: the tool is installed to
#   ~/.local/bin and recorded as ours. Note that a binary found earlier in PATH
#   keeps shadowing it.
#
# Options:
# - -a, --all: select all the tools.
# - -f, --force: also take over tools that are not managed by us.
# - -l, --list: list the tools and their status, then exit.
# - -n, --dry-run: show what would be done, change nothing.
# - -v, --verbose: show the full output of each command.
# - -h, --help: show usage.
set -eu

# Groups of tools (see above)
group_tools() {
	case "$1" in
		@base) echo 'git curl wget unzip zip tree htop jq yq shellcheck' ;;
		@git) echo 'gh glab' ;;
		@docker) echo 'lazydocker dockerc dockerx' ;;
	esac
}
GROUPS_LIST='@base @git @docker'

# Ordered by section of the menu
TOOLS='git curl wget unzip zip tree htop jq yq shellcheck gh glab docker lazydocker dockerc dockerx rsync rclone ripgrep fzf ncdu tmux fd bat 7zip'

# Tool that must be installed for this one to be useful
tool_dep() {
	case "$1" in
		lazydocker|dockerc|dockerx) echo docker ;;
	esac
}

# Section of the menu a tool belongs to
tool_section() {
	case "$1" in
		git|curl|wget|unzip|zip|tree|htop|jq|yq|shellcheck) echo '@base' ;;
		gh|glab) echo '@git' ;;
		docker|lazydocker|dockerc|dockerx) echo '@docker' ;;
		*) echo 'Other' ;;
	esac
}

BIN_DIR="${HOME}/.local/bin"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/tools-install"
GITHUB_USER='matiboux'

all=0
force=0
list_only=0
dry_run=0
verbose=0
requested=''
grouped=''
group_requested=''

usage() {
	echo "Usage: ${0##*/} [-a|--all] [-f|--force] [-l|--list] [-n|--dry-run] [-v|--verbose] [-h|--help] [TOOL|@GROUP...]"
	echo "Tools: ${TOOLS}"
	echo "Groups: ${GROUPS_LIST}"
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		-a|--all) all=1 ;;
		-f|--force) force=1 ;;
		-l|--list) list_only=1 ;;
		-n|--dry-run) dry_run=1 ;;
		-v|--verbose) verbose=1 ;;
		-h|--help)
			usage
			exit 0
			;;
		-*)
			usage >&2
			exit 1
			;;
		@*)
			case " ${GROUPS_LIST} " in
				*" $1 "*) group_requested="${group_requested:-} $1" ;;
				*)
					echo "❌ Unknown group: $1" >&2
					usage >&2
					exit 1
					;;
			esac
			;;
		*)
			case " ${TOOLS} " in
				*" $1 "*) requested="${requested} $1" ;;
				*)
					echo "❌ Unknown tool: $1" >&2
					usage >&2
					exit 1
					;;
			esac
			;;
	esac
	shift
done

# File descriptor 3 is the real standard output: commands run with their output
# captured, but their one-line results still go through
exec 3>&1
pending=0
clear_pending() {
	if [ "${pending}" -eq 1 ]; then
		printf '\r\033[2K' >&3
		pending=0
	fi
}
say() {
	clear_pending
	printf '%s\n' "$*" >&3
}

os="$(uname -s)"
have() { command -v "$1" >/dev/null 2>&1; }

interactive=0
[ -t 0 ] && interactive=1

case "${os}" in
	Linux|Darwin) ;;
	*)
		echo "❌ Unsupported OS: ${os}" >&2
		exit 1
		;;
esac

case "$(uname -m)" in
	x86_64|amd64) arch='amd64' ;;
	aarch64|arm64) arch='arm64' ;;
	*) arch='' ;;
esac

# --- Tool definitions ---

# Command provided by the tool
tool_cmd() {
	case "$1" in
		ripgrep) echo rg ;;
		7zip) echo 7zz ;;
		*) echo "$1" ;;
	esac
}

# Other command names of a tool (apt names fd and bat differently)
tool_alt() {
	case "$1" in
		fd) echo fdfind ;;
		bat) echo batcat ;;
	esac
}

# Package name of a pkg tool, for the package manager in use
tool_pkg() {
	case "$1:$(pkg_manager)" in
		shellcheck:dnf) echo ShellCheck ;;
		fd:apt|fd:dnf) echo fd-find ;;
		*) echo "$1" ;;
	esac
}

# How the tool is installed: pkg (system package), docker, bin (release binary)
tool_kind() {
	case "$1" in
		docker) echo docker ;;
		gh|glab|yq|lazydocker|7zip|dockerc|dockerx) echo bin ;;
		*) echo pkg ;;
	esac
}

# Homebrew formula of a bin tool (empty: no formula, downloaded directly)
tool_brew() {
	case "$1" in
		7zip) echo sevenzip ;;
		dockerc|dockerx) echo '' ;;
		*) echo "$1" ;;
	esac
}

# --- Privileges and package managers ---

as_root() {
	if [ "$(id -u)" -eq 0 ]; then
		env DEBIAN_FRONTEND=noninteractive "$@"
	elif have sudo; then
		# sudo prompts on the terminal, even with the output captured
		if [ "${interactive}" -eq 1 ]; then
			sudo env DEBIAN_FRONTEND=noninteractive "$@"
		else
			sudo -n env DEBIAN_FRONTEND=noninteractive "$@"
		fi
	else
		echo '   Needs root, and sudo is missing.' >&2
		return 1
	fi
}

pkg_manager() {
	if [ "${os}" = Darwin ]; then
		have brew && echo brew
	elif have apt-get; then
		echo apt
	elif have dnf; then
		echo dnf
	elif have brew; then
		echo brew
	fi
}

apt_updated=0

pkg_install() {
	case "$(pkg_manager)" in
		apt)
			if [ "${apt_updated}" -eq 0 ]; then
				as_root apt-get update || return 1
				apt_updated=1
				say '🔄 apt: package lists updated'
			fi
			as_root apt-get install -y "$@"
			;;
		dnf) as_root dnf install -y "$@" ;;
		brew) brew install "$@" ;;
		*) echo '   No supported package manager (apt, dnf, brew).' >&2; return 1 ;;
	esac
}

pkg_upgrade() {
	case "$(pkg_manager)" in
		apt)
			if [ "${apt_updated}" -eq 0 ]; then
				as_root apt-get update || return 1
				apt_updated=1
				say '🔄 apt: package lists updated'
			fi
			as_root apt-get install -y --only-upgrade "$@"
			;;
		dnf) as_root dnf upgrade -y "$@" ;;
		brew) brew upgrade "$@" ;;
		*) echo '   No supported package manager (apt, dnf, brew).' >&2; return 1 ;;
	esac
}

# --- Where is a tool, and who manages it? ---

# Sets R_OWNER: none | ours | local | apt | dnf | brew | external
# R_PATH: path of the command found, R_PKG: package owning it (apt, dnf)
R_OWNER=''
R_PATH=''
R_PKG=''
brew_prefix=''

resolve() {
	cmd="$(tool_cmd "$1")"
	R_OWNER='none'
	R_PATH=''
	R_PKG=''

	if [ "$(tool_kind "$1")" = bin ] && [ -x "${BIN_DIR}/${cmd}" ]; then
		R_PATH="${BIN_DIR}/${cmd}"
		if [ -f "${STATE_DIR}/$1" ]; then R_OWNER='ours'; else R_OWNER='local'; fi
		return 0
	fi

	R_PATH=''
	for name in "${cmd}" $(tool_alt "$1"); do
		R_PATH="$(command -v "${name}" 2>/dev/null || true)"
		[ -z "${R_PATH}" ] || break
	done
	case "${R_PATH}" in
		/*) ;;
		*) R_PATH=''; return 0 ;;
	esac
	R_OWNER='external'

	real="$(readlink -f "${R_PATH}" 2>/dev/null || echo "${R_PATH}")"
	if have dpkg; then
		for candidate in "${R_PATH}" "${real}"; do
			pkg="$(dpkg -S "${candidate}" 2>/dev/null | head -n 1 | sed 's/: \/.*//; s/:[^:]*$//')"
			if [ -n "${pkg}" ]; then
				R_OWNER='apt'
				R_PKG="${pkg}"
				return 0
			fi
		done
	fi
	if have rpm; then
		for candidate in "${R_PATH}" "${real}"; do
			if pkg="$(rpm -qf --qf '%{NAME}' "${candidate}" 2>/dev/null)"; then
				R_OWNER='dnf'
				R_PKG="${pkg}"
				return 0
			fi
		done
	fi
	if have brew; then
		[ -n "${brew_prefix}" ] || brew_prefix="$(brew --prefix 2>/dev/null || echo /nonexistent)"
		case "${real}" in
			"${brew_prefix}"/*) R_OWNER='brew' ;;
		esac
	fi
	return 0
}

# One-line status of a tool, set in STATUS
STATUS=''

compute_status() {
	resolve "$1"
	case "${R_OWNER}" in
		none) STATUS='not installed' ;;
		ours)
			version="$(sed -n 's/^version=//p' "${STATE_DIR}/$1" 2>/dev/null | head -n 1)"
			STATUS="ours ${version} (${R_PATH})"
			;;
		local) STATUS="unmanaged file in our directory (${R_PATH})" ;;
		external) STATUS="not managed by us (${R_PATH})" ;;
		*) STATUS="${R_OWNER} (${R_PATH})" ;;
	esac
}

# --- Downloads ---

tmp_dir=''

keepalive_pid=''
log_file=''

cleanup() {
	[ -z "${tmp_dir}" ] || rm -rf "${tmp_dir}"
	[ -z "${keepalive_pid}" ] || kill "${keepalive_pid}" 2>/dev/null || true
	[ -z "${log_file}" ] || rm -f "${log_file}"
}

# Latest release tag of a GitHub repository, from the redirect of /releases/latest
github_latest() {
	curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$1/releases/latest" | sed 's|.*/tag/||'
}

# Latest release tag of a GitLab project (numeric id)
gitlab_latest() {
	curl -fsSL "https://gitlab.com/api/v4/projects/$1/releases/permalink/latest" \
		| sed -n 's/.*"tag_name":"\([^"]*\)".*/\1/p' | head -n 1
}

# Download <url> into the temporary directory, print the file path
download() {
	file="${tmp_dir}/download.$$.$(basename "$1")"
	curl -fsSL -o "${file}" "$1" || return 1
	echo "${file}"
}

# Install <file> as ~/.local/bin/<name>, and record it
# Usage: put_bin <tool> <file> <name> <version> <source>
put_bin() {
	mkdir -p "${BIN_DIR}" "${STATE_DIR}" || return 1
	install -m 755 "$2" "${BIN_DIR}/$3" || return 1
	printf 'version=%s\nsource=%s\n' "$4" "$5" > "${STATE_DIR}/$1"
}

# Link 7z to 7zz, unless the name is taken by something else (p7zip...)
link_7z() {
	if [ -L "${BIN_DIR}/7z" ] && [ "$(readlink "${BIN_DIR}/7z")" = 7zz ]; then
		return 0
	fi
	if [ -e "${BIN_DIR}/7z" ] || [ -L "${BIN_DIR}/7z" ] || have 7z; then
		RESULT="${RESULT}, 7z not linked (name taken)"
		return 0
	fi
	if ln -s 7zz "${BIN_DIR}/7z"; then
		RESULT="${RESULT}, linked 7z"
	fi
}

# Download and install the latest release of a bin tool to ~/.local/bin.
# Skips when we already have it, unless forced.
direct_install() {
	tool="$1"
	have curl || { echo '   curl is required, install it first.' >&2; return 1; }
	[ -n "${arch}" ] || [ "${tool}" = dockerc ] || [ "${tool}" = dockerx ] || {
		echo "   Unsupported architecture: $(uname -m)" >&2
		return 1
	}
	tmp_dir="$(mktemp -d)"

	case "${tool}" in
		gh)
			tag="$(github_latest cli/cli)"
			v="${tag#v}"
			url="https://github.com/cli/cli/releases/download/${tag}/gh_${v}_linux_${arch}.tar.gz"
			member="gh_${v}_linux_${arch}/bin/gh"
			;;
		glab)
			tag="$(gitlab_latest 34675721)"
			v="${tag#v}"
			url="https://gitlab.com/gitlab-org/cli/-/releases/${tag}/downloads/glab_${v}_linux_${arch}.tar.gz"
			member='bin/glab'
			;;
		lazydocker)
			tag="$(github_latest jesseduffield/lazydocker)"
			v="${tag#v}"
			larch='x86_64'
			[ "${arch}" = arm64 ] && larch='arm64'
			url="https://github.com/jesseduffield/lazydocker/releases/download/${tag}/lazydocker_${v}_Linux_${larch}.tar.gz"
			member='lazydocker'
			;;
		yq)
			tag="$(github_latest mikefarah/yq)"
			url="https://github.com/mikefarah/yq/releases/download/${tag}/yq_linux_${arch}"
			member=''
			;;
		7zip)
			tag="$(github_latest ip7z/7zip)"
			zarch='x64'
			[ "${arch}" = arm64 ] && zarch='arm64'
			url="https://github.com/ip7z/7zip/releases/download/${tag}/7z$(echo "${tag}" | tr -d '.')-linux-${zarch}.tar.xz"
			member='7zz'
			;;
		dockerc|dockerx)
			tag="$(github_latest "${GITHUB_USER}/${tool}")"
			url="https://raw.githubusercontent.com/${GITHUB_USER}/${tool}/${tag}/${tool}"
			member=''
			;;
	esac
	[ -n "${tag}" ] || { echo '   Could not find the latest release.' >&2; return 1; }

	if [ "${force}" -eq 0 ] && [ -f "${STATE_DIR}/${tool}" ] \
		&& [ "$(sed -n 's/^version=//p' "${STATE_DIR}/${tool}")" = "${tag}" ]; then
		RESULT="already at ${tag}"
		return 0
	fi

	file="$(download "${url}")" || { echo "   Download failed: ${url}" >&2; return 1; }
	if [ -n "${member}" ]; then
		mkdir -p "${tmp_dir}/extract" || return 1
		tar -xf "${file}" -C "${tmp_dir}/extract" || return 1
		file="${tmp_dir}/extract/${member}"
	fi
	[ -f "${file}" ] || { echo "   Missing in the archive: ${member}" >&2; return 1; }
	put_bin "${tool}" "${file}" "$(tool_cmd "${tool}")" "${tag}" "${url}" || return 1
	RESULT="${tag} installed in ${BIN_DIR}"
	[ "${tool}" != 7zip ] || link_7z
	rm -rf "${tmp_dir}"
	tmp_dir=''
}

# --- Actions ---

docker_install() {
	if [ "${os}" = Darwin ]; then
		have brew || { echo '   Homebrew is required.' >&2; return 1; }
		brew install --cask docker
	else
		have curl || { echo '   curl is required, install it first.' >&2; return 1; }
		tmp_dir="$(mktemp -d)"
		curl -fsSL https://get.docker.com -o "${tmp_dir}/get-docker.sh" || return 1
		as_root sh "${tmp_dir}/get-docker.sh"
	fi
}

install_tool() {
	case "$(tool_kind "$1")" in
		pkg) pkg_install "$(tool_pkg "$1")" && link_aliases "$1" ;;
		docker) docker_install ;;
		bin)
			formula="$(tool_brew "$1")"
			if [ "${os}" = Darwin ] && [ -n "${formula}" ]; then
				have brew || { echo '   Homebrew is required.' >&2; return 1; }
				brew install "${formula}"
			else
				direct_install "$1"
			fi
			;;
	esac
}

upgrade_tool() {
	pkgs="${R_PKG}"
	[ "${R_OWNER}" != brew ] || pkgs="$1"
	case "$1:${pkgs}" in
		docker:docker-ce-cli) pkgs='docker-ce docker-ce-cli' ;;
	esac
	if [ "${R_OWNER}" = brew ]; then
		formula="$(tool_brew "$1")"
		[ -z "${formula}" ] || [ "$(tool_kind "$1")" != bin ] || pkgs="${formula}"
	fi
	pkg_upgrade ${pkgs} || return 1
	link_aliases "$1"
}

# apt names fd and bat fdfind and batcat: link them as fd and bat when free
EXTRA=''
link_aliases() {
	alt="$(tool_alt "$1")"
	[ -n "${alt}" ] || return 0
	have "$1" && return 0
	target="$(command -v "${alt}" 2>/dev/null || true)"
	[ -n "${target}" ] || return 0
	[ ! -e "${BIN_DIR}/$1" ] && [ ! -L "${BIN_DIR}/$1" ] || return 0
	mkdir -p "${BIN_DIR}" && ln -s "${target}" "${BIN_DIR}/$1" && EXTRA=", linked ${1}"
	return 0
}

# How the action is done, for the logs: apt, dnf, brew, get.docker.com, release
context_of() {
	case "${ACTION}" in
		upgrade) echo "${R_OWNER}" ;;
		*)
			case "$(tool_kind "$1")" in
				pkg) pkg_manager ;;
				docker) if [ "${os}" = Darwin ]; then echo brew; else echo get.docker.com; fi ;;
				bin)
					if [ "${os}" = Darwin ] && [ -n "$(tool_brew "$1")" ]; then echo brew; else echo release; fi
					;;
			esac
			;;
	esac
}

# What to do for a tool, set in ACTION (install, update, upgrade, adopt, skip)
# and REASON
ACTION=''
REASON=''
RESULT=''

plan() {
	resolve "$1"
	REASON=''
	case "${R_OWNER}" in
		none) ACTION='install' ;;
		ours) ACTION='update'; REASON='installed by us' ;;
		apt|dnf|brew) ACTION='upgrade'; REASON="through ${R_OWNER}" ;;
		local|external)
			if [ "${force}" -eq 1 ]; then
				ACTION='adopt'
				REASON="taking over ${R_PATH}"
			else
				ACTION='skip'
				REASON="not managed by us (${R_PATH}), use --force to take over"
			fi
			;;
	esac
	# Package tools are never downloaded: forcing falls back to the package manager
	if [ "${ACTION}" = adopt ] && [ "$(tool_kind "$1")" != bin ]; then
		ACTION='skip'
		REASON="not managed by us (${R_PATH}), packages and docker can't be taken over"
	fi
}

run_tool() {
	case "${ACTION}" in
		install|adopt|update) install_tool "$1" ;;
		upgrade) upgrade_tool "$1" ;;
	esac
}

# --- Menu ---

tool_count=0
for t in ${TOOLS}; do
	tool_count=$((tool_count + 1))
	eval "tool_name_${tool_count}=\$t"
	eval "tool_sel_${tool_count}=0"
	eval "tool_only_${tool_count}=0"
	eval "tool_lock_${tool_count}=0"
	eval "tool_inst_${tool_count}=1"
	eval "tool_depidx_${tool_count}=0"
done

# Read the variable named by $1
get() {
	eval "printf '%s' \"\${$1}\""
}

# Compute the status of each tool, and tick the ones that can be handled
init_menu() {
	i=1
	while [ "${i}" -le "${tool_count}" ]; do
		t="$(get "tool_name_${i}")"
		compute_status "${t}"
		eval "tool_status_${i}=\$STATUS"
		eval "tool_label_${i}=\$(printf '%-11s %s' \"\$t\" \"\$STATUS\")"
		if [ "${R_OWNER}" = none ]; then eval "tool_inst_${i}=0"; else eval "tool_inst_${i}=1"; fi
		# Tools we don't manage can't be ticked, unless forced
		case "${R_OWNER}" in
			external|local)
				eval "tool_sel_${i}=0"
				[ "${force}" -eq 1 ] || eval "tool_lock_${i}=1"
				;;
			*)
				# Ticked by default: the base tools, and what is already installed
				if [ "${R_OWNER}" != none ] || [ "$(tool_section "${t}")" = '@base' ]; then
					eval "tool_sel_${i}=1"
				else
					eval "tool_sel_${i}=0"
				fi
				;;
		esac
		i=$((i + 1))
	done

	# Index of the tool each tool depends on
	i=1
	while [ "${i}" -le "${tool_count}" ]; do
		dep="$(tool_dep "$(get "tool_name_${i}")")"
		if [ -n "${dep}" ]; then
			j=1
			while [ "${j}" -le "${tool_count}" ]; do
				[ "$(get "tool_name_${j}")" != "${dep}" ] || eval "tool_depidx_${i}=${j}"
				j=$((j + 1))
			done
		fi
		i=$((i + 1))
	done

	# Menu rows: a heading before each section, then its tools. Row r is a
	# heading (row_kind_r=h, row_a_r..row_b_r the tools of the section) or a
	# tool (row_kind_r=t, row_a_r the tool).
	row_count=0
	prev=''
	i=1
	while [ "${i}" -le "${tool_count}" ]; do
		section="$(tool_section "$(get "tool_name_${i}")")"
		if [ "${section}" != "${prev}" ]; then
			row_count=$((row_count + 1))
			eval "row_kind_${row_count}=h; row_a_${row_count}=${i}; row_b_${row_count}=${i}; row_name_${row_count}=\$section"
			head_row="${row_count}"
			prev="${section}"
		fi
		eval "row_b_${head_row}=${i}"
		row_count=$((row_count + 1))
		eval "row_kind_${row_count}=t; row_a_${row_count}=${i}"
		i=$((i + 1))
	done

	cascade
}

# Whether tool number $1 can't be ticked: not managed by us, or its dependency
# is neither installed nor ticked. Sets BLOCKED (0 or 1) and NEEDS (the
# dependency, when that is the reason).
BLOCKED=0
NEEDS=''
is_blocked() {
	NEEDS=''
	eval "BLOCKED=\${tool_lock_$1} d=\${tool_depidx_$1}"
	if [ "${BLOCKED}" -ne 1 ] && [ "${d}" -ne 0 ]; then
		eval "inst=\${tool_inst_${d}} dsel=\${tool_sel_${d}}"
		if [ "${inst}" -ne 1 ] && [ "${dsel}" -ne 1 ]; then
			BLOCKED=1
			eval "NEEDS=\${tool_name_${d}}"
		fi
	fi
	return 0
}

# Untick the tools whose dependency is no longer installed nor ticked
cascade() {
	i=1
	while [ "${i}" -le "${tool_count}" ]; do
		is_blocked "${i}"
		[ "${BLOCKED}" -ne 1 ] || eval "tool_sel_${i}=0"
		i=$((i + 1))
	done
}

select_tools() {
	i=1
	while [ "${i}" -le "${tool_count}" ]; do
		case "$1" in
			all) eval "tool_sel_${i}=1" ;;
			free) [ "$(get "tool_lock_${i}")" = 1 ] || eval "tool_sel_${i}=1" ;;
			none) eval "tool_sel_${i}=0" ;;
		esac
		i=$((i + 1))
	done
}

print_list() {
	i=1
	while [ "${i}" -le "${tool_count}" ]; do
		printf '%-11s %s\n' "$(get "tool_name_${i}")" "$(get "tool_status_${i}")"
		i=$((i + 1))
	done
}

# The menu is drawn on the terminal's alternate screen, redrawn in place, so it
# never fills the scrollback and leaves the terminal as it was once closed.
screen_on=0
saved_stty=''

enter_screen() {
	saved_stty="$(stty -g 2>/dev/null || true)"
	stty -icanon -echo min 1 time 0 2>/dev/null || true
	if [ -t 1 ]; then
		printf '\033[?1049h\033[?25l'
		screen_on=1
	fi
}

leave_screen() {
	[ -z "${saved_stty}" ] || stty "${saved_stty}" 2>/dev/null || true
	saved_stty=''
	if [ "${screen_on}" -eq 1 ]; then
		printf '\033[?25h\033[?1049l'
		screen_on=0
	fi
}

cursor=1
top=1

# Control characters, for building a whole frame in one string
esc="$(printf '\033')"
crlf="$(printf '\r\n_')"
crlf="${crlf%_}"

# Append a key hint to the frame: the key as a highlighted badge, then its action
hint() {
	frame="${frame}${esc}[1;7m $1 ${esc}[0m $2   "
}

# The frame is built in a string and written at once, drawn over the previous
# one (each line clears its own end) instead of clearing the screen first, so
# nothing flickers. The terminal is asked to apply it atomically when it can.
print_menu() {
	# Fit the list in the terminal: 2 lines of header and 3 of footer
	size="$(stty size 2>/dev/null || true)"
	rows="${size%% *}"
	cols="${size##* }"
	case "${rows}" in ''|*[!0-9]*) rows=24 ;; esac
	case "${cols}" in ''|*[!0-9]*) cols=80 ;; esac
	visible=$((rows - 5))
	[ "${visible}" -ge 1 ] || visible=1
	[ "${visible}" -le "${row_count}" ] || visible="${row_count}"
	[ "${cursor}" -ge "${top}" ] || top="${cursor}"
	[ "${cursor}" -lt $((top + visible)) ] || top=$((cursor - visible + 1))
	[ "${top}" -ge 1 ] || top=1

	title='Tools to install or update'
	[ "${force}" -eq 1 ] || title="${title} (dimmed: not managed by us, use --force)"
	[ "${visible}" -ge "${row_count}" ] || title="${title} (${cursor}/${row_count})"

	frame=''
	[ "${screen_on}" -eq 0 ] || frame="${esc}[?2026h${esc}[H"
	frame="${frame}${title}${esc}[K${crlf}"
	# Carets on the lines around the list when there is more above or below
	if [ "${top}" -gt 1 ]; then frame="${frame} ▲"; fi
	frame="${frame}${esc}[K${crlf}"
	i="${top}"
	last=$((top + visible - 1))
	while [ "${i}" -le "${last}" ]; do
		eval "kind=\${row_kind_${i}} ref=\${row_a_${i}}"
		dim=''
		if [ "${kind}" = h ]; then
			# Section heading: tick state of the tools that can be ticked
			eval "to=\${row_b_${i}} label=\${row_name_${i}}"
			free=0
			ticked=0
			j="${ref}"
			while [ "${j}" -le "${to}" ]; do
				is_blocked "${j}"
				if [ "${BLOCKED}" -ne 1 ]; then
					free=$((free + 1))
					eval "sel=\${tool_sel_${j}}"
					[ "${sel}" -ne 1 ] || ticked=$((ticked + 1))
				fi
				j=$((j + 1))
			done
			mark=' '
			[ "${ticked}" -eq 0 ] || mark='-'
			[ "${ticked}" -ne "${free}" ] || [ "${free}" -eq 0 ] || mark='x'
			[ "${free}" -ne 0 ] || dim="${esc}[2m"
			line="[${mark}] ${esc}[1m${label}${esc}[22m"
			pad=''
		else
			eval "sel=\${tool_sel_${ref}} label=\"\${tool_label_${ref}}\""
			is_blocked "${ref}"
			mark=' '
			[ "${sel}" -ne 1 ] || mark='x'
			line="[${mark}] ${label}"
			[ -z "${NEEDS}" ] || line="${line} (needs ${NEEDS})"
			[ "${#line}" -le $((cols - 6)) ] || line="$(printf '%s' "${line}" | cut -c "1-$((cols - 6))")"
			[ "${BLOCKED}" -ne 1 ] || dim="${esc}[2m"
			pad='  '
		fi
		if [ "${i}" -eq "${cursor}" ]; then
			frame="${frame}${dim}${esc}[7m > ${pad}${line} ${esc}[0m${esc}[K${crlf}"
		else
			frame="${frame}${dim}   ${pad}${line}${esc}[0m${esc}[K${crlf}"
		fi
		i=$((i + 1))
	done
	if [ "${last}" -lt "${row_count}" ]; then frame="${frame} ▼"; fi
	frame="${frame}${esc}[K${crlf}"
	hint '↑↓' 'move'
	hint 'SPACE' 'toggle'
	frame="${frame}${esc}[K${crlf}"
	hint 'A' 'all'
	hint 'N' 'none'
	hint 'ENTER' 'run'
	hint 'Q' 'quit'
	frame="${frame}${esc}[K"
	[ "${screen_on}" -eq 0 ] || frame="${frame}${esc}[J${esc}[?2026l"
	printf '%s' "${frame}"
}

# Toggle the tool of a row, or all the tools of a section heading. A tool that
# is blocked can't be ticked.
toggle_row() {
	eval "kind=\${row_kind_$1} from=\${row_a_$1}"
	to="${from}"
	[ "${kind}" != h ] || eval "to=\${row_b_$1}"
	# A section is unticked when all of it is ticked, ticked otherwise
	target=0
	j="${from}"
	while [ "${j}" -le "${to}" ]; do
		is_blocked "${j}"
		eval "sel=\${tool_sel_${j}}"
		[ "${BLOCKED}" -eq 1 ] || [ "${sel}" -eq 1 ] || target=1
		j=$((j + 1))
	done
	j="${from}"
	while [ "${j}" -le "${to}" ]; do
		is_blocked "${j}"
		# In order: a tool ticked here can unblock the next ones
		if [ "${target}" -eq 0 ]; then
			eval "lock=\${tool_lock_${j}}"
			[ "${lock}" -eq 1 ] || eval "tool_sel_${j}=0"
		elif [ "${BLOCKED}" -ne 1 ]; then
			eval "tool_sel_${j}=1"
		fi
		j=$((j + 1))
	done
	cascade
}

# Bytes of an escape sequence that were cut at the end of a read
keybuf=''

# Keys are read in bulk, and all those waiting are handled before the next
# redraw: holding a key down never queues up redraws.
menu_loop() {
	while true; do
		print_menu
		chunk="$(dd bs=256 count=1 2>/dev/null | od -An -tx1 | tr -d '\n')"
		if [ -z "${chunk}" ]; then # end of input
			leave_screen
			echo 'Aborted.'
			exit 0
		fi
		# shellcheck disable=SC2086
		set -- ${keybuf} ${chunk}
		keybuf=''
		while [ "$#" -gt 0 ]; do
			key="$1"
			shift
			case "${key}" in
				71) leave_screen; echo 'Aborted.'; exit 0 ;; # q
				0a|0d) return 0 ;; # enter
				20) toggle_row "${cursor}" ;; # space
				61) select_tools free; cascade ;; # a
				6e) select_tools none; cascade ;; # n
				6b) [ "${cursor}" -le 1 ] || cursor=$((cursor - 1)) ;; # k
				6a) [ "${cursor}" -ge "${row_count}" ] || cursor=$((cursor + 1)) ;; # j
				1b)
					# Arrow keys send ESC [ A or ESC [ B (ESC O A/B in application mode)
					if [ "$#" -eq 0 ]; then
						keybuf="${key}"
					elif [ "$1" = 5b ] || [ "$1" = 4f ]; then
						if [ "$#" -lt 2 ]; then
							keybuf="${key} $1"
							set --
						else
							case "$2" in
								41) [ "${cursor}" -le 1 ] || cursor=$((cursor - 1)) ;;
								42) [ "${cursor}" -ge "${row_count}" ] || cursor=$((cursor + 1)) ;;
							esac
							shift 2
						fi
					fi
					;;
			esac
		done
	done
}

run_menu() {
	enter_screen
	trap 'leave_screen' EXIT
	trap 'leave_screen; exit 130' INT TERM
	menu_loop
	leave_screen
	trap - EXIT INT TERM
}

# --- Main ---

init_menu

# Expand the groups
for g in ${group_requested}; do
	grouped="${grouped} $(group_tools "${g}")"
done

if [ "${list_only}" -eq 1 ]; then
	print_list
	exit 0
fi

if [ "${all}" -eq 1 ]; then
	select_tools all
elif [ -n "${requested}${grouped}" ]; then
	select_tools none
	i=1
	while [ "${i}" -le "${tool_count}" ]; do
		case " ${requested} " in
			*" $(get "tool_name_${i}") "*) eval "tool_sel_${i}=1" ;;
			*)
				case " ${grouped} " in
					*" $(get "tool_name_${i}") "*) eval "tool_sel_${i}=1; tool_only_${i}=1" ;;
				esac
				;;
		esac
		i=$((i + 1))
	done
elif [ -n "${group_requested}" ]; then
	echo 'Nothing to install.'
	exit 0
elif [ "${interactive}" -eq 1 ]; then
	run_menu
else
	print_list
	echo
	usage
	exit 0
fi

trap cleanup EXIT
trap 'exit 130' INT TERM

# A tool whose dependency is neither installed nor selected can't be run
dep_failed=0
i=1
while [ "${i}" -le "${tool_count}" ]; do
	if [ "$(get "tool_sel_${i}")" = 1 ]; then
		is_blocked "${i}"
		if [ -n "${NEEDS}" ]; then
			echo "❌ $(get "tool_name_${i}") needs ${NEEDS}, which is not installed: add ${NEEDS} to the command." >&2
			dep_failed=1
		fi
	fi
	i=$((i + 1))
done
[ "${dep_failed}" -eq 0 ] || exit 1

# Plan tool number $1: sets t, ACTION and REASON
plan_item() {
	t="$(get "tool_name_$1")"
	plan "${t}"
	# Tools from a group are only installed when missing
	if [ "$(get "tool_only_$1")" = 1 ] && [ "${ACTION}" != install ]; then
		ACTION='skip'
		REASON='already installed'
	fi
}

# Whether the planned action needs root (run after plan_item)
needs_root() {
	[ "$(id -u)" -ne 0 ] || return 1
	case "${ACTION}" in
		upgrade) case "${R_OWNER}" in apt|dnf) return 0 ;; esac ;;
		install|adopt|update)
			case "$(tool_kind "${t}")" in
				pkg|docker) [ "${os}" = Linux ] && return 0 ;;
			esac
			;;
	esac
	return 1
}

# Ask for sudo once, up front, and keep it alive for the whole run
root_needed=0
i=1
while [ "${i}" -le "${tool_count}" ]; do
	if [ "$(get "tool_sel_${i}")" = 1 ]; then
		plan_item "${i}"
		! needs_root || root_needed=1
	fi
	i=$((i + 1))
done
if [ "${root_needed}" -eq 1 ] && [ "${dry_run}" -eq 0 ] && [ "${interactive}" -eq 1 ] && have sudo; then
	if sudo -v; then
		(
			while sleep 50; do
				sudo -n true 2>/dev/null || exit
				kill -0 "$$" 2>/dev/null || exit
			done
		) &
		keepalive_pid=$!
	else
		echo '⚠️ No sudo access: tools requiring root will fail.' >&2
	fi
fi

[ "${dry_run}" -eq 1 ] || [ "${verbose}" -eq 1 ] || log_file="$(mktemp)"

selected=0
count_done=0
count_skipped=0
count_failed=0

# Say how an upgrade went, from the package manager's output
upgrade_result() {
	if grep -q '^0 upgraded, 0 newly installed' "${log_file}" 2>/dev/null \
		|| grep -q 'Nothing to do' "${log_file}" 2>/dev/null \
		|| { [ "$(pkg_manager)" = brew ] && [ ! -s "${log_file}" ]; }; then
		echo 'already up to date'
	else
		echo 'upgraded'
	fi
}

i=1
while [ "${i}" -le "${tool_count}" ]; do
	if [ "$(get "tool_sel_${i}")" = 1 ]; then
		selected=$((selected + 1))
		plan_item "${i}"
		case "${ACTION}" in
			skip)
				echo "⏭️ ${t}: ${REASON}"
				count_skipped=$((count_skipped + 1))
				;;
			*)
				via="$(context_of "${t}")"
				if [ "${dry_run}" -eq 1 ]; then
					echo "📦 ${t}: would ${ACTION} (${via})"
					i=$((i + 1))
					continue
				fi
				# Transient line while it works, replaced by the result
				if [ "${verbose}" -eq 0 ] && [ -t 1 ]; then
					printf '⏳ %s: %s (%s)...' "${t}" "${ACTION}" "${via}"
					pending=1
				fi
				RESULT=''
				EXTRA=''
				status=0
				if [ "${verbose}" -eq 1 ]; then
					run_tool "${t}" || status=$?
				else
					run_tool "${t}" >"${log_file}" 2>&1 || status=$?
				fi
				if [ "${status}" -eq 0 ]; then
					if [ -z "${RESULT}" ]; then
						case "${ACTION}" in
							upgrade) RESULT="$(upgrade_result)" ;;
							*) RESULT='installed' ;;
						esac
					fi
					clear_pending
					echo "✅ ${t}: ${RESULT}${EXTRA} (${via})"
					count_done=$((count_done + 1))
				else
					clear_pending
					echo "❌ ${t}: ${ACTION} failed, exit ${status} (${via})"
					[ "${verbose}" -eq 1 ] || tail -n 15 "${log_file}" | sed 's/^ *//; s/^/   | /'
					count_failed=$((count_failed + 1))
				fi
				;;
		esac
	fi
	i=$((i + 1))
done

echo
if [ "${selected}" -eq 0 ]; then
	echo 'Nothing selected.'
elif [ "${dry_run}" -eq 1 ]; then
	echo "👏 Dry run done: ${selected} tool(s) looked at, nothing was changed."
else
	echo "👏 Done! ${count_done} run, ${count_skipped} skipped, ${count_failed} failed."
fi
case ":${PATH}:" in
	*":${BIN_DIR}:"*) ;;
	*) [ ! -d "${BIN_DIR}" ] || echo "⚠️ ${BIN_DIR} is not in PATH." ;;
esac
# Groups are best-effort: a failure does not fail the run
[ "${count_failed}" -eq 0 ] || [ -z "${grouped}" ] || [ -n "${requested}" ]
