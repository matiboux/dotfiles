#!/bin/sh
# Pull the latest changes of the dotfiles git repo and reinstall the dotfiles.
#
# Usage: dotfiles-update [-h|--help]
#
# The repo (on the main branch, with a clean working directory) is updated with
# a fast-forward only pull, its submodules are updated, then its install.sh
# script is run.
#
# Options:
# - -h, --help: show usage.
#
# Environment:
# - DOTFILES_DIR: directory of the dotfiles git repo.
#   (default: ~/dotfiles, then ~/.dotfiles)
set -eu

DOTFILES_REPO='matiboux/dotfiles'

usage() {
	echo "Usage: ${0##*/} [-h|--help]"
}

# Wrapped in a function so that the whole script is parsed before running,
# since install.sh overwrites this very file while it is executing.
main() {
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-h|--help)
				usage
				return 0
				;;
			*)
				usage >&2
				return 1
				;;
		esac
	done

	# Locate the dotfiles directory
	if [ -z "${DOTFILES_DIR:-}" ]; then
		if [ -d "${HOME}/dotfiles" ]; then
			DOTFILES_DIR="${HOME}/dotfiles"
		else
			DOTFILES_DIR="${HOME}/.dotfiles"
		fi
	fi

	[ -d "${DOTFILES_DIR}" ] || {
		echo "⚠️ Dotfiles directory not found: ${DOTFILES_DIR}" >&2
		return 1
	}

	if ! git -C "${DOTFILES_DIR}" rev-parse --git-dir >/dev/null 2>&1; then
		echo "❌ Not a git repository: ${DOTFILES_DIR}" >&2
		return 2
	fi

	# Verify that the repository is ours
	origin_url="$(git -C "${DOTFILES_DIR}" remote get-url origin 2>/dev/null || true)"
	origin_slug="$(printf '%s' "${origin_url}" | tr '[:upper:]' '[:lower:]' | sed -E 's#\.git/?$##; s#^.*[:/]([^:/]+/[^:/]+)$#\1#')"
	[ "${origin_slug}" = "${DOTFILES_REPO}" ] || {
		echo "❌ Not the expected dotfiles repository (${DOTFILES_REPO}): ${DOTFILES_DIR}" >&2
		return 2
	}

	if [ ! -f "${DOTFILES_DIR}/install.sh" ]; then
		echo "❌ Install script not found: ${DOTFILES_DIR}/install.sh" >&2
		return 2
	fi

	# Verify that the repository is on the main branch
	current_branch="$(git -C "${DOTFILES_DIR}" symbolic-ref --short -q HEAD || true)"
	[ "${current_branch}" = 'main' ] || {
		echo "⚠️ Dotfiles repository is not on the main branch." >&2
		return 1
	}

	if [ -n "$(git -C "${DOTFILES_DIR}" status --porcelain)" ]; then
		echo '❌ Working directory is not clean. Please commit or stash your changes before running this script.' >&2
		return 1
	fi

	# Pull latest changes from the main branch
	# Git output is captured and only shown on failure, then summarized in one line.
	old_head="$(git -C "${DOTFILES_DIR}" rev-parse HEAD)"
	pull_output="$(git -C "${DOTFILES_DIR}" pull --ff-only 2>&1)" || {
		printf '%s\n' "${pull_output}" >&2
		echo "❌ Failed to pull latest changes." >&2
		return 1
	}
	new_head="$(git -C "${DOTFILES_DIR}" rev-parse HEAD)"

	if [ "${old_head}" = "${new_head}" ]; then
		echo "✅ Branch ${current_branch} already up to date."
	else
		commit_count="$(git -C "${DOTFILES_DIR}" rev-list --count "${old_head}..${new_head}")"
		# e.g. "14 files +1518 -105" (binary files count as 0 lines)
		diff_summary="$(git -C "${DOTFILES_DIR}" diff --numstat "${old_head}" "${new_head}" \
			| awk '{ f++; a += $1; d += $2 } END { printf "%d file%s +%d -%d", f, (f == 1 ? "" : "s"), a, d }')"
		echo "✅ Updated ${current_branch}: ${commit_count} commit$([ "${commit_count}" = 1 ] || echo s), ${diff_summary}"
	fi

	# Update submodules if any
	git -C "${DOTFILES_DIR}" submodule update -q --init --recursive || {
		echo "❌ Failed to update submodules." >&2
		return 1
	}

	# Install updated dotfiles
	sh "${DOTFILES_DIR}/install.sh" || {
		echo "❌ Failed to install updated dotfiles." >&2
		return 1
	}

	echo "✅ Dotfiles update completed successfully."
}

main "$@"
exit
