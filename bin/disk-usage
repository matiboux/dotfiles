#!/bin/sh
# Show what takes space in a directory.
# Supports Linux and macOS.
#
# Usage: disk-usage [-n COUNT] [-m SIZE_MB] [-a|--all] [-h|--help] [DIR]
#
# Prints four sections for DIR (default: current directory):
# - Depth 1: size of each entry, heaviest first, with the total on top.
#   Entries under 0.1% of the total are hidden.
# - Excluded directories: total size of the dependency/cache directories
#   skipped in the file sections (see EXCLUDED_DIRS below), grouped by name.
# - Heaviest files: the COUNT heaviest files (searched recursively) above the size threshold.
# - Summary: number and total size of files above the threshold, by extension.
#   Extensions with a single file are merged in one "other" line, since those
#   files are already listed above when they are heavy enough.
#
# Options:
# - -n, --count COUNT: number of heaviest files to list (default: 5).
# - -m, --min-size SIZE_MB: size threshold in MB (default: 10).
# - -a, --all: show every depth 1 entry and exclude no directory from the file sections.
# - -h, --help: show usage.
set -eu

# Directory names excluded from the file sections (space-separated, exact names).
EXCLUDED_DIRS='.git .venv venv node_modules __pycache__ .cache cache'

count=5
min_mb=10
all=0

usage() {
	echo "Usage: ${0##*/} [-n|--count COUNT] [-m|--min-size SIZE_MB] [-a|--all] [-h|--help] [DIR]"
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		-n|--count) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; count=$2; shift 2 ;;
		-m|--min-size) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; min_mb=$2; shift 2 ;;
		-a|--all) all=1; shift ;;
		-h|--help) usage; exit 0 ;;
		--) shift; break ;;
		-*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
		*) break ;;
	esac
done

dir=${1:-.}
[ -d "$dir" ] || { echo "Not a directory: $dir" >&2; exit 1; }

case "$count$min_mb" in
	''|*[!0-9]*) echo "COUNT and SIZE_MB must be positive integers" >&2; exit 2 ;;
esac

# Print the find expression matching the excluded directory names:
# ( -name a -o -name b ... )
excluded_expr() {
	printf '('
	sep=''
	for name in $EXCLUDED_DIRS; do
		printf ' %s-name %s' "$sep" "$name"
		sep='-o '
	done
	printf ' )\n'
}
# Unquoted on purpose: split into find arguments (no name contains a space or glob).
excl=$(excluded_expr)

# Print "<bytes> <path>" for each file above the threshold, skipping excluded
# directories unless --all. find -exec ... {} + never runs stat without
# arguments, unlike an empty xargs.
if stat -c '%s' / >/dev/null 2>&1; then
	big_files() {
		if [ "$all" -eq 1 ]; then
			find "$dir" -type f -size +"${min_mb}"M -exec stat -c '%s %n' {} + 2>/dev/null
		else
			# shellcheck disable=SC2086
			find "$dir" -type d $excl -prune -o -type f -size +"${min_mb}"M -exec stat -c '%s %n' {} + 2>/dev/null
		fi
	}
else
	big_files() {
		if [ "$all" -eq 1 ]; then
			find "$dir" -type f -size +"${min_mb}"M -exec stat -f '%z %N' {} + 2>/dev/null
		else
			# shellcheck disable=SC2086
			find "$dir" -type d $excl -prune -o -type f -size +"${min_mb}"M -exec stat -f '%z %N' {} + 2>/dev/null
		fi
	}
fi

# Turn a leading byte count into a human readable size, and show the home
# directory as ~ in the path (plain string match, no regex).
humanize() {
	awk -v home="${HOME:-}" '{
		s = $1; sub(/^[0-9]+ /, "")
		if (home != "" && (index($0, home "/") == 1 || $0 == home)) $0 = "~" substr($0, length(home) + 1)
		split("B K M G T P", u, " "); i = 1
		while (s >= 1024 && i < 6) { s /= 1024; i++ }
		if (i == 1) printf "%6d%s  %s\n", s, u[i], $0
		else printf "%6.1f%s  %s\n", s, u[i], $0
	}'
}

# Same ~ replacement for a single path.
tilde() {
	case "$1" in
		"${HOME:-/nonexistent}") echo '~' ;;
		"${HOME:-/nonexistent}"/*) echo "~${1#"$HOME"}" ;;
		*) echo "$1" ;;
	esac
}

echo "== Depth 1 sizes: $(tilde "$dir") =="
# "<bytes> <path>" lines, DIR itself included.
du_out=$(du -k -d 1 "$dir" 2>/dev/null | awk '{
	s = $1 * 1024; p = $0; sub(/^[0-9]+[ \t]+/, "", p)
	print s " " p
}')
total=$(echo "$du_out" | awk -v d="$dir" '{
	s = $1; sub(/^[0-9]+ /, "")
	if ($0 == d) print s
}')
[ -n "$total" ] || total=$(echo "$du_out" | sort -nr | awk 'NR == 1 { print $1 }')
echo "Total: $(echo "$total ." | humanize | awk '{ print $1 }')"
entries=$(echo "$du_out" | awk -v d="$dir" '{
	s = $1; p = $0; sub(/^[0-9]+ /, "", p)
	if (p != d) print
}' | sort -nr)
if [ "$all" -eq 1 ]; then
	shown=$entries
else
	shown=$(echo "$entries" | awk -v t="$total" '$1 * 1000 >= t')
fi
echo "$shown" | humanize
hidden=$(( $(echo "$entries" | wc -l) - $(echo "$shown" | wc -l) ))
if [ "$hidden" -gt 0 ]; then
	echo "(+ $hidden entries under 0.1% hidden, use --all to show them)"
fi

if [ "$all" -eq 0 ]; then
	echo
	echo "== Excluded from the file sections (use --all to include) =="
	# shellcheck disable=SC2086
	excluded=$(find "$dir" -mindepth 1 -type d $excl -prune -print 2>/dev/null |
		while IFS= read -r d; do
			du -sk "$d" 2>/dev/null | awk -v name="${d##*/}" '{ print $1 * 1024 " " name }'
		done |
		awk '{ c[$2]++; t[$2] += $1 } END { for (n in c) print t[n] " " c[n] " " n }' |
		sort -nr)
	if [ -z "$excluded" ]; then
		echo "None"
	else
		echo "$excluded" | awk '{
			s = $1; n = $2; e = $3
			split("B K M G T P", u, " "); i = 1
			while (s >= 1024 && i < 6) { s /= 1024; i++ }
			printf "%6.1f%s  %4d dir%s  %s\n", s, u[i], n, (n > 1 ? "s" : " "), e
		}'
	fi
fi

echo
echo "== Heaviest files (> ${min_mb}MB): top $count =="
big=$(big_files | sort -nr || true)
if [ -z "$big" ]; then
	echo "None"
	exit 0
fi
echo "$big" | head -n "$count" | humanize

echo
echo "== Summary by extension (> ${min_mb}MB) =="
ext_out=$(echo "$big" | awk -v all="$all" '{
	s = $1; sub(/^[0-9]+ /, "")
	path = $0
	n = split(path, parts, "/"); f = parts[n]
	sub(/(\.[0-9]+)+$/, "", f)  # libfoo.so.12.1 -> libfoo.so
	if (f ~ /\.[A-Za-z][A-Za-z0-9_]*$/) { ext = tolower(f); sub(/^.*\./, "", ext); ext = "." ext }
	else if (path ~ /\/\.git\/objects\//) ext = "(git objects)"
	else ext = "(none)"
	c[ext]++; t[ext] += s
}
END {
	for (e in c) {
		if (c[e] > 1 || all == 1) print t[e] " " c[e] " " e
		else { oc++; ot += t[e] }
	}
	if (oc > 0) print "other " ot " " oc
}')
echo "$ext_out" | grep -v '^other ' | sort -nr | awk '{
	s = $1; n = $2; e = $3 ($4 != "" ? " " $4 : "")
	split("B K M G T P", u, " "); i = 1
	while (s >= 1024 && i < 6) { s /= 1024; i++ }
	printf "%6.1f%s  %4d file%s  %s\n", s, u[i], n, (n > 1 ? "s" : " "), e
}'
echo "$ext_out" | grep '^other ' | awk '{
	s = $2; n = $3
	split("B K M G T P", u, " "); i = 1
	while (s >= 1024 && i < 6) { s /= 1024; i++ }
	printf "(+ %d file%s for %.1f%s, use --all to show them)\n", n, (n > 1 ? "s" : ""), s, u[i]
}'
