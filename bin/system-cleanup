#!/bin/sh
# Free disk space by cleaning caches, temporary files, logs and unused data.
# Supports Linux and macOS.
#
# Usage: system-cleanup [-y|--yes] [-s|--safe] [-n|--dry-run] [-v|--verbose] [-h|--help]
#
# A menu lists the available tasks, to tick or untick (arrow keys and space)
# before running them.
# Tasks are split in two levels:
# - safe: caches that are rebuilt on demand (package managers, ~/.cache, docker
#   build cache and unused images...). Ticked by default.
# - sensitive: removes data that may matter (logs, old temporary files, trash,
#   unused packages, unused docker volumes...). Unticked by default.
#
# Once you confirm the menu, sudo is requested a single time (only if a selected
# task needs it), and the selected tasks run unattended.
#
# Options:
# - -y, --yes: no menu, run all tasks, safe and sensitive.
# - -s, --safe: no menu, run safe tasks only.
# - -n, --dry-run: only list the tasks that would run.
# - -v, --verbose: show the full output of each task.
# - -h, --help: show usage.
#
# Each task prints a one-line summary (space freed). Its output is hidden, and
# only shown when the task fails or with --verbose.
#
# Without a terminal, the menu is skipped and only safe tasks run.
set -eu

mode=''
dry_run=0
verbose=0

usage() {
	echo "Usage: ${0##*/} [-y|--yes] [-s|--safe] [-n|--dry-run] [-v|--verbose] [-h|--help]"
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		-y|--yes) mode='all' ;;
		-s|--safe) mode='safe' ;;
		-n|--dry-run) dry_run=1 ;;
		-v|--verbose) verbose=1 ;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			usage >&2
			exit 1
			;;
	esac
	shift
done

os="$(uname -s)"
have() { command -v "$1" >/dev/null 2>&1; }

interactive=0
[ -t 0 ] && interactive=1

sudo_ok=0
[ "$(id -u)" -eq 0 ] && sudo_ok=1

# Run a command as root
as_root() {
	if [ "$(id -u)" -eq 0 ]; then
		"$@"
	elif [ "${sudo_ok}" -eq 1 ]; then
		# On a terminal, let sudo prompt again if its cached credentials expired
		if [ "${interactive}" -eq 1 ]; then sudo "$@"; else sudo -n "$@"; fi
	else
		echo '   ⏭️ Needs root, skipped.' >&2
		return 1
	fi
}

# Fail with a message when root privileges are not available
require_root() {
	[ "$(id -u)" -eq 0 ] || [ "${sudo_ok}" -eq 1 ] || {
		echo '   ⏭️ Needs root, skipped.' >&2
		return 1
	}
}

# Delete the content of a directory, keeping the directory itself
# Usage: empty_dir [--root] <dir>
empty_dir() {
	runner=''
	if [ "$1" = '--root' ]; then
		require_root || return 1
		runner='as_root'
		shift
	fi
	dir="$1"
	case "${dir}" in
		''|/|"${HOME}"|"${HOME}/") echo "❌ Refusing to empty: '${dir}'" >&2; return 1 ;;
	esac
	[ -d "${dir}" ] || return 0
	# Files in use may fail to be deleted, which is fine
	${runner} find "${dir}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
}

# Delete old files of a directory, without crossing filesystems and keeping sockets
# Usage: delete_older_than <days> <dir>
delete_older_than() {
	require_root || return 1
	as_root find "$2" -xdev -mindepth 1 ! -type s ! -path '*/.X11-unix*' ! -path '*/.ICE-unix*' \
		-mtime "+$1" -delete 2>/dev/null || true
}

avail_kb() {
	df -Pk / | awk 'NR==2 { print $4 }'
}

# --- Task registry (POSIX sh has no arrays: task_<field>_<index> variables) ---

task_count=0

# Quote an argument so that it can be safely eval'd
quote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Read the variable named by $1
get() {
	eval "printf '%s' \"\${$1}\""
}

# Register a task. Safe tasks are selected by default.
# Usage: task <safe|sensitive> <description> <command> [args...]
task() {
	level="$1"
	description="$2"
	shift 2

	command_line=''
	for arg in "$@"; do
		command_line="${command_line} $(quote "${arg}")"
	done

	task_count=$((task_count + 1))
	eval "task_level_${task_count}=\$level"
	eval "task_desc_${task_count}=\$description"
	eval "task_cmd_${task_count}=\$command_line"
	if [ "${level}" = 'safe' ]; then
		eval "task_sel_${task_count}=1"
	else
		eval "task_sel_${task_count}=0"
	fi
}

# Select tasks: all, safe (only safe ones), none
select_tasks() {
	i=1
	while [ "${i}" -le "${task_count}" ]; do
		case "$1:$(get "task_level_${i}")" in
			all:*|safe:safe) eval "task_sel_${i}=1" ;;
			*) eval "task_sel_${i}=0" ;;
		esac
		i=$((i + 1))
	done
}

docker_ready() { have docker && docker info >/dev/null 2>&1; }

linux_tasks() {
	docker_ready && task safe 'Docker: delete unused images, containers, networks and build cache' \
		docker system prune -f -a
	docker_ready && task sensitive 'Docker: delete unused volumes (may hold data)' \
		docker volume prune -f

	have apt-get && task safe 'APT: delete downloaded package files' as_root apt-get clean
	have apt-get && task sensitive 'APT: delete unused packages' as_root apt-get autoremove -y
	have npm && task safe 'npm: delete cache' npm cache clean --force
	have pnpm && task safe 'pnpm: delete unreferenced store packages' pnpm store prune
	have yarn && task safe 'Yarn: delete cache' yarn cache clean
	have pip && task safe 'pip: delete cache' pip cache purge
	have go && task safe 'Go: delete build cache' go clean -cache

	[ -d "${HOME}/.cache" ] && task safe 'Cache: delete ~/.cache contents' empty_dir "${HOME}/.cache"

	have journalctl && task sensitive 'Logs: delete journal entries older than 7 days' \
		as_root journalctl --vacuum-time=7d
	[ -d /var/log ] && task sensitive 'Logs: delete rotated logs in /var/log older than 7 days' \
		as_root find /var/log -xdev -type f \( -name '*.gz' -o -name '*.[0-9]' -o -name '*.old' \) -mtime +7 -delete
	[ -d "${HOME}/.local/share/Trash" ] && task sensitive 'Trash: delete trashed files' \
		empty_dir "${HOME}/.local/share/Trash"
	[ -d /tmp ] && task sensitive 'Temp: delete /tmp files older than 7 days' delete_older_than 7 /tmp
	[ -d /var/tmp ] && task sensitive 'Temp: delete /var/tmp files older than 30 days' delete_older_than 30 /var/tmp
	return 0
}

macos_tasks() {
	docker_ready && task safe 'Docker: delete unused images, containers, networks and build cache' \
		docker system prune -f -a
	docker_ready && task sensitive 'Docker: delete unused volumes (may hold data)' \
		docker volume prune -f

	have brew && task safe 'Homebrew: delete old versions and cache' brew cleanup --prune=all -s
	have npm && task safe 'npm: delete cache' npm cache clean --force
	have pnpm && task safe 'pnpm: delete unreferenced store packages' pnpm store prune
	have yarn && task safe 'Yarn: delete cache' yarn cache clean
	have pip && task safe 'pip: delete cache' pip cache purge
	have go && task safe 'Go: delete build cache' go clean -cache

	# /System/Library/Caches is protected by SIP and managed by the OS: left alone
	task safe 'Cache: delete ~/Library/Caches contents' empty_dir "${HOME}/Library/Caches"
	task safe 'Cache: delete /Library/Caches contents' empty_dir --root /Library/Caches
	[ -d "${HOME}/Library/Developer/Xcode/DerivedData" ] && task safe 'Xcode: delete DerivedData' \
		empty_dir "${HOME}/Library/Developer/Xcode/DerivedData"

	task sensitive 'Logs: delete ~/Library/Logs contents' empty_dir "${HOME}/Library/Logs"
	task sensitive 'Logs: delete /Library/Logs contents' empty_dir --root /Library/Logs
	[ -d "${HOME}/.Trash" ] && task sensitive 'Trash: delete trashed files' empty_dir "${HOME}/.Trash"
	[ -d /tmp ] && task sensitive 'Temp: delete /tmp files older than 7 days' delete_older_than 7 /tmp
	return 0
}

case "${os}" in
	Linux) linux_tasks ;;
	Darwin) macos_tasks ;;
	*)
		echo "❌ Unsupported OS: ${os}" >&2
		exit 1
		;;
esac

# --- Menu ---

# The menu is drawn on the terminal's alternate screen, redrawn in place, so it
# never fills the scrollback and leaves the terminal as it was once closed.
screen_on=0
saved_stty=''

enter_screen() {
	saved_stty="$(stty -g 2>/dev/null || true)"
	stty -icanon -echo min 1 time 0 2>/dev/null || true
	if [ -t 1 ]; then
		# Alternate screen, hidden cursor
		printf '\033[?1049h\033[?25l'
		screen_on=1
	fi
}

leave_screen() {
	[ -z "${saved_stty}" ] || stty "${saved_stty}" 2>/dev/null || true
	saved_stty=''
	if [ "${screen_on}" -eq 1 ]; then
		printf '\033[?25h\033[?1049l'
		screen_on=0
	fi
}

cursor=1

# Print a key hint: the key as a highlighted badge, then its action
hint() {
	printf '\033[1;7m %s \033[0m %s   ' "$1" "$2"
}

print_menu() {
	# Clear the screen and move the cursor to the top-left corner
	[ "${screen_on}" -eq 1 ] && printf '\033[H\033[2J'
	printf 'Cleanup tasks (! = sensitive)\r\n\r\n'
	i=1
	while [ "${i}" -le "${task_count}" ]; do
		mark=' '
		[ "$(get "task_sel_${i}")" = 1 ] && mark='x'
		flag='  '
		[ "$(get "task_level_${i}")" = 'sensitive' ] && flag='! '
		if [ "${i}" -eq "${cursor}" ]; then
			printf '\033[7m > [%s] %s%s \033[0m\r\n' "${mark}" "${flag}" "$(get "task_desc_${i}")"
		else
			printf '   [%s] %s%s\r\n' "${mark}" "${flag}" "$(get "task_desc_${i}")"
		fi
		i=$((i + 1))
	done
	printf '\r\n'
	hint '↑↓' 'move'
	hint 'SPACE' 'toggle'
	printf '\r\n'
	hint 'A' 'all'
	hint 'S' 'safe only'
	hint 'N' 'none'
	hint 'ENTER' 'run'
	hint 'Q' 'quit'
	printf '\r\n'
}

# Read one byte as hexadecimal (empty on end of input)
read_hex() {
	dd bs=1 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n'
}

toggle_task() {
	if [ "$(get "task_sel_$1")" = 1 ]; then
		eval "task_sel_$1=0"
	else
		eval "task_sel_$1=1"
	fi
}

menu_loop() {
	while true; do
		print_menu
		key="$(read_hex)"
		case "${key}" in
			''|71) leave_screen; echo 'Aborted.'; exit 0 ;; # end of input, q
			0a|0d) return 0 ;; # enter
			20) toggle_task "${cursor}" ;; # space
			61) select_tasks all ;; # a
			73) select_tasks safe ;; # s
			6e) select_tasks none ;; # n
			6b) [ "${cursor}" -le 1 ] || cursor=$((cursor - 1)) ;; # k
			6a) [ "${cursor}" -ge "${task_count}" ] || cursor=$((cursor + 1)) ;; # j
			1b)
				# Arrow keys send ESC [ A or ESC [ B (ESC O A/B in application mode)
				stty min 0 time 1 2>/dev/null || true
				second="$(read_hex)"
				third="$(read_hex)"
				stty min 1 time 0 2>/dev/null || true
				case "${second}:${third}" in
					5b:41|4f:41) [ "${cursor}" -le 1 ] || cursor=$((cursor - 1)) ;;
					5b:42|4f:42) [ "${cursor}" -ge "${task_count}" ] || cursor=$((cursor + 1)) ;;
				esac
				;;
		esac
	done
}

run_menu() {
	enter_screen
	trap 'leave_screen' EXIT
	trap 'leave_screen; exit 130' INT TERM
	menu_loop
	leave_screen
	trap - EXIT INT TERM
}

case "${mode}" in
	all) select_tasks all ;;
	safe) select_tasks safe ;;
	*) [ "${interactive}" -eq 1 ] && run_menu ;;
esac

# --- Run ---

selected=0
needs_root=0
i=1
while [ "${i}" -le "${task_count}" ]; do
	if [ "$(get "task_sel_${i}")" = 1 ]; then
		selected=$((selected + 1))
		case "$(get "task_cmd_${i}")" in
			*as_root*|*--root*|*delete_older_than*) needs_root=1 ;;
		esac
	fi
	i=$((i + 1))
done

if [ "${selected}" -eq 0 ]; then
	echo 'Nothing selected.'
	exit 0
fi

log_file=''
keepalive_pid=''

cleanup() {
	[ -z "${keepalive_pid}" ] || kill "${keepalive_pid}" 2>/dev/null || true
	[ -z "${log_file}" ] || rm -f "${log_file}"
}

# Ask for sudo once, and keep it alive for the whole run
if [ "${needs_root}" -eq 1 ] && [ "${sudo_ok}" -eq 0 ] && [ "${dry_run}" -eq 0 ] \
	&& have sudo && [ "${interactive}" -eq 1 ]; then
	echo 'Some selected tasks need root privileges.'
	if sudo -v; then
		sudo_ok=1
		(
			while sleep 50; do
				sudo -n true 2>/dev/null || exit
				kill -0 "$$" 2>/dev/null || exit
			done
		) &
		keepalive_pid=$!
	else
		echo '⚠️ No sudo access: tasks requiring root will be skipped.' >&2
	fi
fi

# Task output is captured in a temporary file
if [ "${dry_run}" -eq 0 ] && [ "${verbose}" -eq 0 ]; then
	log_file="$(mktemp)"
fi
trap cleanup EXIT
trap 'exit 130' INT TERM

# Format an amount of kilobytes
format_kb() {
	if [ "$1" -ge 1024 ]; then
		echo "~$(($1 / 1024)) MB"
	else
		echo '<1 MB'
	fi
}

before="$(avail_kb)"
count_done=0
count_failed=0

echo
i=1
while [ "${i}" -le "${task_count}" ]; do
	if [ "$(get "task_sel_${i}")" = 1 ]; then
		echo "🧹 $(get "task_desc_${i}")"
		if [ "${dry_run}" -eq 1 ]; then
			echo '   (dry run)'
		else
			task_before="$(avail_kb)"
			status=0
			if [ "${verbose}" -eq 1 ]; then
				eval "$(get "task_cmd_${i}")" || status=$?
			else
				eval "$(get "task_cmd_${i}")" >"${log_file}" 2>&1 || status=$?
			fi
			if [ "${status}" -eq 0 ]; then
				task_freed=$(( $(avail_kb) - task_before ))
				[ "${task_freed}" -ge 0 ] || task_freed=0
				echo "   Done, $(format_kb "${task_freed}") freed."
				count_done=$((count_done + 1))
			else
				echo "   Failed (exit ${status}), continuing."
				[ "${verbose}" -eq 1 ] || tail -n 10 "${log_file}" | sed 's/^ *//; s/^/   | /'
				count_failed=$((count_failed + 1))
			fi
		fi
	fi
	i=$((i + 1))
done

echo
if [ "${dry_run}" -eq 1 ]; then
	echo "👏 Dry run done: ${selected} task(s) would run, nothing was changed."
else
	after="$(avail_kb)"
	freed_mb=$(( (after - before) / 1024 ))
	[ "${freed_mb}" -ge 0 ] || freed_mb=0
	echo "👏 Done! ${count_done} task(s) run, ${count_failed} failed, $((task_count - selected)) not selected, ~${freed_mb} MB freed on /."
fi
