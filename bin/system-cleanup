#!/bin/sh
# Free disk space by cleaning caches, temporary files, logs and unused data.
# Supports Linux and macOS.
#
# Usage: system-cleanup [-y|--yes] [-s|--safe] [-n|--dry-run] [-h|--help]
#
# A menu lists the available tasks, to tick or untick before running them.
# Tasks are split in two levels:
# - safe: caches that are rebuilt on demand (package managers, ~/.cache, docker
#   build cache and unused images...). Ticked by default.
# - sensitive: removes data that may matter (logs, old temporary files, trash,
#   unused packages, unused docker volumes...). Unticked by default.
#
# Once you confirm the menu, sudo is requested a single time (only if a selected
# task needs it), and the selected tasks run unattended.
#
# Options:
# - -y, --yes: no menu, run all tasks, safe and sensitive.
# - -s, --safe: no menu, run safe tasks only.
# - -n, --dry-run: only list the tasks that would run.
# - -h, --help: show usage.
#
# Without a terminal, the menu is skipped and only safe tasks run.
set -eu

mode=''
dry_run=0

usage() {
	echo "Usage: ${0##*/} [-y|--yes] [-s|--safe] [-n|--dry-run] [-h|--help]"
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		-y|--yes) mode='all' ;;
		-s|--safe) mode='safe' ;;
		-n|--dry-run) dry_run=1 ;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			usage >&2
			exit 1
			;;
	esac
	shift
done

os="$(uname -s)"
have() { command -v "$1" >/dev/null 2>&1; }

interactive=0
[ -t 0 ] && interactive=1

sudo_ok=0
[ "$(id -u)" -eq 0 ] && sudo_ok=1

# Run a command as root
as_root() {
	if [ "$(id -u)" -eq 0 ]; then
		"$@"
	elif [ "${sudo_ok}" -eq 1 ]; then
		# On a terminal, let sudo prompt again if its cached credentials expired
		if [ "${interactive}" -eq 1 ]; then sudo "$@"; else sudo -n "$@"; fi
	else
		echo '   ⏭️ Needs root, skipped.' >&2
		return 1
	fi
}

# Fail with a message when root privileges are not available
require_root() {
	[ "$(id -u)" -eq 0 ] || [ "${sudo_ok}" -eq 1 ] || {
		echo '   ⏭️ Needs root, skipped.' >&2
		return 1
	}
}

# Delete the content of a directory, keeping the directory itself
# Usage: empty_dir [--root] <dir>
empty_dir() {
	runner=''
	if [ "$1" = '--root' ]; then
		require_root || return 1
		runner='as_root'
		shift
	fi
	dir="$1"
	case "${dir}" in
		''|/|"${HOME}"|"${HOME}/") echo "❌ Refusing to empty: '${dir}'" >&2; return 1 ;;
	esac
	[ -d "${dir}" ] || return 0
	# Files in use may fail to be deleted, which is fine
	${runner} find "${dir}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
}

# Delete old files of a directory, without crossing filesystems and keeping sockets
# Usage: delete_older_than <days> <dir>
delete_older_than() {
	require_root || return 1
	as_root find "$2" -xdev -mindepth 1 ! -type s ! -path '*/.X11-unix*' ! -path '*/.ICE-unix*' \
		-mtime "+$1" -delete 2>/dev/null || true
}

avail_kb() {
	df -Pk / | awk 'NR==2 { print $4 }'
}

# --- Task registry (POSIX sh has no arrays: task_<field>_<index> variables) ---

task_count=0

# Quote an argument so that it can be safely eval'd
quote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Read the variable named by $1
get() {
	eval "printf '%s' \"\${$1}\""
}

# Register a task. Safe tasks are selected by default.
# Usage: task <safe|sensitive> <description> <command> [args...]
task() {
	level="$1"
	description="$2"
	shift 2

	command_line=''
	for arg in "$@"; do
		command_line="${command_line} $(quote "${arg}")"
	done

	task_count=$((task_count + 1))
	eval "task_level_${task_count}=\$level"
	eval "task_desc_${task_count}=\$description"
	eval "task_cmd_${task_count}=\$command_line"
	if [ "${level}" = 'safe' ]; then
		eval "task_sel_${task_count}=1"
	else
		eval "task_sel_${task_count}=0"
	fi
}

# Select tasks: all, safe (only safe ones), none
select_tasks() {
	i=1
	while [ "${i}" -le "${task_count}" ]; do
		case "$1:$(get "task_level_${i}")" in
			all:*|safe:safe) eval "task_sel_${i}=1" ;;
			*) eval "task_sel_${i}=0" ;;
		esac
		i=$((i + 1))
	done
}

docker_ready() { have docker && docker info >/dev/null 2>&1; }

linux_tasks() {
	docker_ready && task safe 'Docker: remove unused images, containers, networks and build cache' \
		docker system prune -f -a
	docker_ready && task sensitive 'Docker: remove unused volumes (may hold data!)' \
		docker volume prune -f

	have apt-get && task safe 'APT: clean the package cache' as_root apt-get clean
	have apt-get && task sensitive 'APT: remove unused packages' as_root apt-get autoremove -y
	have npm && task safe 'npm: clean the cache' npm cache clean --force
	have pnpm && task safe 'pnpm: prune the store' pnpm store prune
	have yarn && task safe 'Yarn: clean the cache' yarn cache clean
	have pip && task safe 'pip: purge the cache' pip cache purge
	have go && task safe 'Go: clean the build cache' go clean -cache

	[ -d "${HOME}/.cache" ] && task safe 'Empty ~/.cache' empty_dir "${HOME}/.cache"

	have journalctl && task sensitive 'Logs: delete journal entries older than 7 days' \
		as_root journalctl --vacuum-time=7d
	[ -d /var/log ] && task sensitive 'Logs: delete rotated logs in /var/log older than 7 days' \
		as_root find /var/log -xdev -type f \( -name '*.gz' -o -name '*.[0-9]' -o -name '*.old' \) -mtime +7 -delete
	[ -d "${HOME}/.local/share/Trash" ] && task sensitive 'Trash: empty it' \
		empty_dir "${HOME}/.local/share/Trash"
	[ -d /tmp ] && task sensitive 'Temp: delete /tmp files older than 7 days' delete_older_than 7 /tmp
	[ -d /var/tmp ] && task sensitive 'Temp: delete /var/tmp files older than 30 days' delete_older_than 30 /var/tmp
	return 0
}

macos_tasks() {
	docker_ready && task safe 'Docker: remove unused images, containers, networks and build cache' \
		docker system prune -f -a
	docker_ready && task sensitive 'Docker: remove unused volumes (may hold data!)' \
		docker volume prune -f

	have brew && task safe 'Homebrew: remove old versions and cache' brew cleanup --prune=all -s
	have npm && task safe 'npm: clean the cache' npm cache clean --force
	have pnpm && task safe 'pnpm: prune the store' pnpm store prune
	have yarn && task safe 'Yarn: clean the cache' yarn cache clean
	have pip && task safe 'pip: purge the cache' pip cache purge
	have go && task safe 'Go: clean the build cache' go clean -cache

	# /System/Library/Caches is protected by SIP and managed by the OS: left alone
	task safe 'Empty ~/Library/Caches' empty_dir "${HOME}/Library/Caches"
	task safe 'Empty /Library/Caches' empty_dir --root /Library/Caches
	[ -d "${HOME}/Library/Developer/Xcode/DerivedData" ] && task safe 'Empty Xcode DerivedData' \
		empty_dir "${HOME}/Library/Developer/Xcode/DerivedData"

	task sensitive 'Logs: empty ~/Library/Logs' empty_dir "${HOME}/Library/Logs"
	task sensitive 'Logs: empty /Library/Logs' empty_dir --root /Library/Logs
	[ -d "${HOME}/.Trash" ] && task sensitive 'Trash: empty it' empty_dir "${HOME}/.Trash"
	[ -d /tmp ] && task sensitive 'Temp: delete /tmp files older than 7 days' delete_older_than 7 /tmp
	return 0
}

case "${os}" in
	Linux) linux_tasks ;;
	Darwin) macos_tasks ;;
	*)
		echo "❌ Unsupported OS: ${os}" >&2
		exit 1
		;;
esac

# --- Menu ---

# The menu is drawn on the terminal's alternate screen, redrawn in place, so it
# never fills the scrollback and leaves the terminal as it was once closed.
screen_on=0

enter_screen() {
	if [ -t 1 ]; then
		printf '\033[?1049h'
		screen_on=1
	fi
}

leave_screen() {
	if [ "${screen_on}" -eq 1 ]; then
		printf '\033[?1049l'
		screen_on=0
	fi
}

notice=''

print_menu() {
	# Clear the screen and move the cursor to the top-left corner
	[ "${screen_on}" -eq 1 ] && printf '\033[H\033[2J'
	echo 'Cleanup tasks ([x] = will run, ⚠️ = sensitive):'
	echo
	i=1
	while [ "${i}" -le "${task_count}" ]; do
		mark=' '
		[ "$(get "task_sel_${i}")" = 1 ] && mark='x'
		flag='  '
		[ "$(get "task_level_${i}")" = 'sensitive' ] && flag='⚠️ '
		printf ' [%s] %2d) %s%s\n' "${mark}" "${i}" "${flag}" "$(get "task_desc_${i}")"
		i=$((i + 1))
	done
	echo
	[ -z "${notice}" ] || echo "${notice}"
	notice=''
}

menu_loop() {
	while true; do
		print_menu
		printf 'Toggle by number (e.g. "3 5"), [a]ll, [s]afe only, [n]one, [Enter] run, [q]uit: '
		read -r input || input='q'
		[ -n "${input}" ] || return 0
		for token in ${input}; do
			case "${token}" in
				a) select_tasks all ;;
				s) select_tasks safe ;;
				n) select_tasks none ;;
				q) leave_screen; echo 'Aborted.'; exit 0 ;;
				*[!0-9]*|'') notice="Ignored: ${token}" ;;
				*)
					if [ "${token}" -ge 1 ] && [ "${token}" -le "${task_count}" ]; then
						if [ "$(get "task_sel_${token}")" = 1 ]; then
							eval "task_sel_${token}=0"
						else
							eval "task_sel_${token}=1"
						fi
					else
						notice="Ignored: ${token}"
					fi
					;;
			esac
		done
	done
}

run_menu() {
	enter_screen
	trap 'leave_screen' EXIT
	trap 'leave_screen; exit 130' INT TERM
	menu_loop
	leave_screen
	trap - EXIT INT TERM
}

case "${mode}" in
	all) select_tasks all ;;
	safe) select_tasks safe ;;
	*) [ "${interactive}" -eq 1 ] && run_menu ;;
esac

# --- Run ---

selected=0
needs_root=0
i=1
while [ "${i}" -le "${task_count}" ]; do
	if [ "$(get "task_sel_${i}")" = 1 ]; then
		selected=$((selected + 1))
		case "$(get "task_cmd_${i}")" in
			*as_root*|*--root*|*delete_older_than*) needs_root=1 ;;
		esac
	fi
	i=$((i + 1))
done

if [ "${selected}" -eq 0 ]; then
	echo 'Nothing selected.'
	exit 0
fi

# Ask for sudo once, and keep it alive for the whole run
if [ "${needs_root}" -eq 1 ] && [ "${sudo_ok}" -eq 0 ] && [ "${dry_run}" -eq 0 ] \
	&& have sudo && [ "${interactive}" -eq 1 ]; then
	echo 'Some selected tasks need root privileges.'
	if sudo -v; then
		sudo_ok=1
		(
			while sleep 50; do
				sudo -n true 2>/dev/null || exit
				kill -0 "$$" 2>/dev/null || exit
			done
		) &
		keepalive_pid=$!
		trap 'kill "${keepalive_pid}" 2>/dev/null || true' EXIT INT TERM
	else
		echo '⚠️ No sudo access: tasks requiring root will be skipped.' >&2
	fi
fi

before="$(avail_kb)"
count_done=0
count_failed=0

echo
i=1
while [ "${i}" -le "${task_count}" ]; do
	if [ "$(get "task_sel_${i}")" = 1 ]; then
		echo "🧹 $(get "task_desc_${i}")"
		if [ "${dry_run}" -eq 1 ]; then
			echo '   (dry run)'
		elif eval "$(get "task_cmd_${i}")"; then
			count_done=$((count_done + 1))
		else
			echo '   ❌ Failed, continuing.' >&2
			count_failed=$((count_failed + 1))
		fi
	fi
	i=$((i + 1))
done

echo
if [ "${dry_run}" -eq 1 ]; then
	echo "👏 Dry run done: ${selected} task(s) would run, nothing was changed."
else
	after="$(avail_kb)"
	freed_mb=$(( (after - before) / 1024 ))
	[ "${freed_mb}" -ge 0 ] || freed_mb=0
	echo "👏 Done! ${count_done} task(s) run, ${count_failed} failed, $((task_count - selected)) not selected, ~${freed_mb} MB freed on /."
fi
