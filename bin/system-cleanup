#!/bin/sh
# Free disk space by cleaning caches, temporary files, logs and unused data.
# Supports Linux and macOS.
#
# Usage: system-cleanup [-y|--yes] [-s|--safe] [-n|--dry-run] [-h|--help]
#
# Tasks are split in two levels:
# - safe: caches that are rebuilt on demand (package managers, ~/.cache, docker
#   build cache and unused images...). Always run without asking.
# - sensitive: removes data that may matter (logs, old temporary files, trash,
#   unused packages, unused docker volumes...). Asked for, one by one.
#
# At start, you are asked once how to handle sensitive tasks, and for your sudo
# password once, so the rest can run unattended.
#
# Options:
# - -y, --yes: autonomous mode, run safe and sensitive tasks without asking.
# - -s, --safe: safe mode, run safe tasks only and skip sensitive ones.
# - -n, --dry-run: only list the tasks that would run.
# - -h, --help: show usage.
set -eu

mode=''
dry_run=0

usage() {
	echo "Usage: ${0##*/} [-y|--yes] [-s|--safe] [-n|--dry-run] [-h|--help]"
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		-y|--yes) mode='auto' ;;
		-s|--safe) mode='safe' ;;
		-n|--dry-run) dry_run=1 ;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			usage >&2
			exit 1
			;;
	esac
	shift
done

os="$(uname -s)"
have() { command -v "$1" >/dev/null 2>&1; }

interactive=0
[ -t 0 ] && interactive=1

# Without a terminal, nothing can be asked: only run the safe tasks
if [ -z "${mode}" ]; then
	if [ "${interactive}" -eq 1 ]; then
		echo 'How should sensitive cleanups (logs, old temp files, trash, unused packages/volumes) be handled?'
		echo '  [a] Autonomous: run everything without asking again'
		echo '  [s] Safe only: caches only, skip sensitive tasks'
		echo '  [i] Interactive: ask for each sensitive task (default)'
		printf 'Choice [a/s/I]: '
		read -r choice || choice=''
		case "${choice}" in
			a|A) mode='auto' ;;
			s|S) mode='safe' ;;
			*) mode='ask' ;;
		esac
	else
		mode='safe'
	fi
fi

# Ask for sudo once, and keep it alive for the whole run
sudo_ok=0
if [ "$(id -u)" -eq 0 ]; then
	sudo_ok=1
elif [ "${dry_run}" -eq 0 ] && have sudo && [ "${interactive}" -eq 1 ]; then
	echo 'Some tasks need root privileges.'
	if sudo -v; then
		sudo_ok=1
		(
			while sleep 50; do
				sudo -n true 2>/dev/null || exit
				kill -0 "$$" 2>/dev/null || exit
			done
		) &
		keepalive_pid=$!
		trap 'kill "${keepalive_pid}" 2>/dev/null || true' EXIT INT TERM
	else
		echo '⚠️ No sudo access: tasks requiring root will be skipped.' >&2
	fi
fi

# Run a command as root
as_root() {
	if [ "$(id -u)" -eq 0 ]; then
		"$@"
	elif [ "${sudo_ok}" -eq 1 ]; then
		sudo -n "$@"
	else
		echo '   ⏭️ Needs root, skipped.' >&2
		return 1
	fi
}

# Delete the content of a directory, keeping the directory itself
# Usage: empty_dir [--root] <dir>
empty_dir() {
	runner=''
	if [ "$1" = '--root' ]; then
		runner='as_root'
		shift
	fi
	dir="$1"
	case "${dir}" in
		''|/|"${HOME}"|"${HOME}/") echo "❌ Refusing to empty: '${dir}'" >&2; return 1 ;;
	esac
	[ -d "${dir}" ] || return 0
	# Files in use may fail to be deleted, which is fine
	${runner} find "${dir}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
}

# Delete old files of a directory, without crossing filesystems and keeping sockets
# Usage: delete_older_than <days> <dir>
delete_older_than() {
	as_root find "$2" -xdev -mindepth 1 ! -type s ! -path '*/.X11-unix*' ! -path '*/.ICE-unix*' \
		-mtime "+$1" -delete 2>/dev/null || true
}

confirm() {
	[ "${interactive}" -eq 1 ] || return 1
	printf '   ❓ %s [y/N] ' "$1"
	read -r reply || reply=''
	case "${reply}" in
		y|Y|yes|YES) return 0 ;;
		*) return 1 ;;
	esac
}

avail_kb() {
	df -Pk / | awk 'NR==2 { print $4 }'
}

count_done=0
count_skipped=0

# Usage: task <safe|sensitive> <description> <command> [args...]
task() {
	level="$1"
	description="$2"
	shift 2

	if [ "${level}" = 'sensitive' ]; then
		echo "⚠️  ${description}"
		if [ "${mode}" = 'safe' ]; then
			echo '   ⏭️ Sensitive, skipped (safe mode).'
			count_skipped=$((count_skipped + 1))
			return 0
		fi
		if [ "${mode}" = 'ask' ] && [ "${dry_run}" -eq 0 ] && ! confirm 'Run this sensitive cleanup?'; then
			echo '   ⏭️ Skipped.'
			count_skipped=$((count_skipped + 1))
			return 0
		fi
	else
		echo "🧹 ${description}"
	fi

	if [ "${dry_run}" -eq 1 ]; then
		echo '   (dry run)'
		return 0
	fi

	if "$@"; then
		count_done=$((count_done + 1))
	else
		echo '   ❌ Failed, continuing.' >&2
	fi
}

docker_ready() { have docker && docker info >/dev/null 2>&1; }

linux_tasks() {
	docker_ready && task safe 'Docker: remove unused images, containers, networks and build cache' \
		docker system prune -f -a
	docker_ready && task sensitive 'Docker: remove unused volumes (may hold data!)' \
		docker volume prune -f

	have apt-get && task safe 'APT: clean the package cache' as_root apt-get clean
	have apt-get && task sensitive 'APT: remove unused packages' as_root apt-get autoremove -y
	have npm && task safe 'npm: clean the cache' npm cache clean --force
	have pnpm && task safe 'pnpm: prune the store' pnpm store prune
	have yarn && task safe 'Yarn: clean the cache' yarn cache clean
	have pip && task safe 'pip: purge the cache' pip cache purge
	have go && task safe 'Go: clean the build cache' go clean -cache

	[ -d "${HOME}/.cache" ] && task safe 'Empty ~/.cache' empty_dir "${HOME}/.cache"

	have journalctl && task sensitive 'Journal logs: keep the last 7 days only' \
		as_root journalctl --vacuum-time=7d
	[ -d /var/log ] && task sensitive 'Delete rotated/compressed logs in /var/log' \
		as_root find /var/log -xdev -type f \( -name '*.gz' -o -name '*.[0-9]' -o -name '*.old' \) -delete
	[ -d "${HOME}/.local/share/Trash" ] && task sensitive 'Empty the trash' \
		empty_dir "${HOME}/.local/share/Trash"
	[ -d /tmp ] && task sensitive 'Delete files in /tmp older than 7 days' delete_older_than 7 /tmp
	[ -d /var/tmp ] && task sensitive 'Delete files in /var/tmp older than 30 days' delete_older_than 30 /var/tmp
	return 0
}

macos_tasks() {
	docker_ready && task safe 'Docker: remove unused images, containers, networks and build cache' \
		docker system prune -f -a
	docker_ready && task sensitive 'Docker: remove unused volumes (may hold data!)' \
		docker volume prune -f

	have brew && task safe 'Homebrew: remove old versions and cache' brew cleanup --prune=all -s
	have npm && task safe 'npm: clean the cache' npm cache clean --force
	have pnpm && task safe 'pnpm: prune the store' pnpm store prune
	have yarn && task safe 'Yarn: clean the cache' yarn cache clean
	have pip && task safe 'pip: purge the cache' pip cache purge
	have go && task safe 'Go: clean the build cache' go clean -cache

	# /System/Library/Caches is protected by SIP and managed by the OS: left alone
	task safe 'Empty ~/Library/Caches' empty_dir "${HOME}/Library/Caches"
	task safe 'Empty /Library/Caches' empty_dir --root /Library/Caches
	[ -d "${HOME}/Library/Developer/Xcode/DerivedData" ] && task safe 'Empty Xcode DerivedData' \
		empty_dir "${HOME}/Library/Developer/Xcode/DerivedData"

	task sensitive 'Empty ~/Library/Logs' empty_dir "${HOME}/Library/Logs"
	task sensitive 'Empty /Library/Logs' empty_dir --root /Library/Logs
	[ -d "${HOME}/.Trash" ] && task sensitive 'Empty the trash' empty_dir "${HOME}/.Trash"
	[ -d /tmp ] && task sensitive 'Delete files in /tmp older than 7 days' delete_older_than 7 /tmp
	return 0
}

before="$(avail_kb)"

case "${os}" in
	Linux) linux_tasks ;;
	Darwin) macos_tasks ;;
	*)
		echo "❌ Unsupported OS: ${os}" >&2
		exit 1
		;;
esac

echo
if [ "${dry_run}" -eq 1 ]; then
	echo '👏 Dry run done, nothing was changed.'
else
	after="$(avail_kb)"
	freed_mb=$(( (after - before) / 1024 ))
	[ "${freed_mb}" -ge 0 ] || freed_mb=0
	echo "👏 Done! ${count_done} task(s) run, ${count_skipped} skipped, ~${freed_mb} MB freed on /."
fi
