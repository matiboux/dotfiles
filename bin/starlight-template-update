#!/bin/sh
# Update the Starlight template files of a project from the latest starlight-template
# repository, on a dedicated update branch.
#
# Usage: starlight-template-update [-h|--help] [<project_path> [<app_dir>]]
#
# The update branch (feat/update-starlight-template) is created from the current branch if it is a
# primary branch (dev, staging, main, master), else from the first remote-tracking
# primary branch found. The template is cloned, customized with the project
# information (slug, site title, GitHub repository), then copied to the project.
# The template commit hash is committed in <app_dir>/.starlight-template.
#
# Arguments:
# - <project_path>: path of the project to update.
#   (default: WORKING_DIR)
# - <app_dir>: app directory, relative to the project path.
#   (default: app)
#
# Options:
# - -h, --help: show usage.
#
# Environment:
# - WORKING_DIR: directory of the project, if no project path is given.
#   (default: shell current directory)
set -eu

# Script inputs:
DEFAULT_GIT_REMOTE='origin'
UPDATE_GIT_BRANCH='feat/update-starlight-template'
APP_DIR='app'

# Primary branches, in order of preference to create the update branch from
PRIMARY_GIT_BRANCHES='dev staging main master'

usage() {
	echo "Usage: ${0##*/} [-h|--help] [<project_path> [<app_dir>]]"
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		-h|--help)
			usage
			exit 0
			;;
		--)
			shift
			break
			;;
		-*)
			usage >&2
			exit 1
			;;
		*)
			break
			;;
	esac
done

if [ "$#" -gt 2 ]; then
	usage >&2
	exit 1
fi

WORKING_DIR="${1:-${WORKING_DIR:-$(pwd)}}"
APP_DIR="${2:-${APP_DIR}}"

if ! git -C "${WORKING_DIR}" rev-parse --git-dir >/dev/null 2>&1; then
	echo "❌ Not a git repository: ${WORKING_DIR}" >&2
	exit 2
fi

git_repo() {
	git -C "${WORKING_DIR}" "$@"
}

# ---

TEMPLATE_PATH=''
ERR_FILE=''
SED_FILE=''

cleanup_trap() {
	if [ -n "${TEMPLATE_PATH}" ] && [ "${TEMPLATE_PATH#/tmp}" != "${TEMPLATE_PATH}" ]; then
		rm -rf -- "${TEMPLATE_PATH}"
	fi
	if [ -n "${ERR_FILE}" ] && [ "${ERR_FILE#/tmp}" != "${ERR_FILE}" ]; then
		rm -f -- "${ERR_FILE}"
	fi
	if [ -n "${SED_FILE}" ] && [ "${SED_FILE#/tmp}" != "${SED_FILE}" ]; then
		rm -f -- "${SED_FILE}"
	fi
}

trap 'cleanup_trap' EXIT INT TERM

sanitize_err() {
	tr '\n' ' ' <"$1" | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'
}

# ---

CURRENT_BRANCH="$(git_repo branch --show-current)"

if [ "${CURRENT_BRANCH}" = "${UPDATE_GIT_BRANCH}" ]; then

	echo "✅ Already on update branch '${UPDATE_GIT_BRANCH}'."

else

	# Check if the working directory is clean
	if [ -n "$(git_repo status --porcelain)" ]; then
		echo '❌ Working directory is not clean. Please commit or stash your changes before running this script.'
		exit 1
	fi

	# Fetch latest updates from remote
	git_repo fetch "${DEFAULT_GIT_REMOTE}"

	if case " ${PRIMARY_GIT_BRANCHES} " in *" ${CURRENT_BRANCH} "*) true ;; *) false ;; esac; then
		# Current branch is a primary branch

		# Merge with latest updates from remote
		git_repo merge --ff-only "${DEFAULT_GIT_REMOTE}/${CURRENT_BRANCH}"

		# Create update branch from the current branch
		git_repo checkout -b "${UPDATE_GIT_BRANCH}" "${CURRENT_BRANCH}"

		echo "✅ Checked out update branch '${UPDATE_GIT_BRANCH}' (created from current branch)."

	else

		# Create the update branch from first found remote-tracking branch in order of priority
		for branch in ${PRIMARY_GIT_BRANCHES}; do
			if git_repo show-ref --verify --quiet "refs/remotes/${DEFAULT_GIT_REMOTE}/${branch}"; then
				git_repo checkout -b "${UPDATE_GIT_BRANCH}" "refs/remotes/${DEFAULT_GIT_REMOTE}/${branch}"
				break
			fi
		done

		# Verify that the update branch was created and checked out
		if [ "$(git_repo branch --show-current)" != "${UPDATE_GIT_BRANCH}" ]; then
			echo "❌ Failed to check out update branch '${UPDATE_GIT_BRANCH}'."
			exit 1
		fi

		echo "✅ Checked out update branch '${UPDATE_GIT_BRANCH}' (created from remote-tracking branch)."

	fi

fi

# ---

if [ ! -f "${WORKING_DIR}/.env" ]; then
	PROJECT_SLUG=''
else
	# Get the project slug from the .env file
	PROJECT_SLUG="$(
		grep -E '^IMAGES_PREFIX=' "${WORKING_DIR}/.env" \
		| cut -d '=' -f 2- | sed -E "s/^['\"]|['\"]$//g"
	)"
fi

if [ ! -f "${WORKING_DIR}/${APP_DIR}/src/site.ts" ]; then
	SITE_TITLE=''
	GITHUB_REPO_PATH=''
else
	# Get the site title from the site.ts file
	SITE_TITLE="$(
		grep -E "^[[:space:]]*title:[[:space:]]*['\"]" "${WORKING_DIR}/${APP_DIR}/src/site.ts" \
		| env LC_ALL=C sed -E "s/^[[:space:]]*title:[[:space:]]*['\"]([^'\"]*)['\"],?.*$/\1/"
	)"

	# Get the github repository path from the site.ts file
	GITHUB_REPO_PATH="$(
		grep -E "^[[:space:]]*\|\|[[:space:]]+['\"]https?://github\\.com/" "${WORKING_DIR}/${APP_DIR}/src/site.ts" \
		| env LC_ALL=C sed -E "s/^[[:space:]]*\|\|[[:space:]]+['\"]https?:\/\/github\\.com\/([^'\"/]+\/[^'\"/]+).*/\1/"
	)"
fi

echo '✅ Fetched project information.'

# ---

TEMPLATE_PATH="$(mktemp -d)"
ERR_FILE="$(mktemp)"

if ! git clone \
	--depth 1 \
	git@github.com:matiboux/starlight-template.git \
	"${TEMPLATE_PATH}" \
	> /dev/null 2> "${ERR_FILE}" \
	; then

	err_text="$(sanitize_err "${ERR_FILE}")"
	echo '❌ Failed to clone Starlight template repository'
	[ -n "${err_text}" ] && echo "${err_text}" >&2
	exit 1
fi

echo '✅ Cloned Starlight template repository.'

# ---

sanitize_sed_part() {
	echo "$1" | sed 's/\([\/&]\)/\\\1/g'
}
SED_FILE="$(mktemp)"

[ -n "${GITHUB_REPO_PATH}" ] && printf 's/%s/%s/g\n' 'matiboux\/starlight-template' "$(sanitize_sed_part "${GITHUB_REPO_PATH}")" >> "${SED_FILE}"
[ -n "${SITE_TITLE}" ] && printf 's/%s/%s/g\n' 'Starlight Template' "$(sanitize_sed_part "${SITE_TITLE}")" >> "${SED_FILE}"
[ -n "${PROJECT_SLUG}" ] && printf 's/%s/%s/g\n' 'starlight-template' "$(sanitize_sed_part "${PROJECT_SLUG}")" >> "${SED_FILE}"

if [ -s "${SED_FILE}" ]; then
	find "${TEMPLATE_PATH}" -type f | while IFS= read -r file; do

		# Skip binary files (e.g. images)
		if ! LC_ALL=C grep -Iq . "${file}"; then
			continue
		fi

		update_file="$(mktemp)" || {
			echo "❌ Failed to create temporary file for updating '${file}'."
			exit 1
		}

		env LC_ALL=C sed -f "${SED_FILE}" -- "${file}" > "${update_file}" || {
			echo "❌ Failed to update file '${file}'."
			rm -f -- "${update_file}"
			exit 1
		}

		# Preserve executable permission bit
		[ -x "${file}" ] && chmod +x "${update_file}"

		# Replace original file with updated file
		mv "${update_file}" "${file}"

	done
fi

echo '✅ Updated template files with project information.'

# ---

cp "${TEMPLATE_PATH}/.editorconfig" "${WORKING_DIR}/"
cp "${TEMPLATE_PATH}/.env"* "${WORKING_DIR}/"
cp "${TEMPLATE_PATH}/.gitignore" "${WORKING_DIR}/"
cp "${TEMPLATE_PATH}/docker-compose"* "${WORKING_DIR}/"
cp "${TEMPLATE_PATH}/Makefile" "${WORKING_DIR}/"
cp "${TEMPLATE_PATH}/README.md" "${WORKING_DIR}/"

mkdir -p "${WORKING_DIR}/.devcontainer/"
cp "${TEMPLATE_PATH}/.devcontainer/"*.* "${WORKING_DIR}/.devcontainer/"

mkdir -p "${WORKING_DIR}/.github/workflows/"
cp "${TEMPLATE_PATH}/.github/workflows/"*.* "${WORKING_DIR}/.github/workflows/"

mkdir -p "${WORKING_DIR}/.github/workflows/scripts/"
cp "${TEMPLATE_PATH}/.github/workflows/scripts/"*.* "${WORKING_DIR}/.github/workflows/scripts/"

mkdir -p "${WORKING_DIR}/.vscode/"
cp "${TEMPLATE_PATH}/.vscode/extensions.json" "${WORKING_DIR}/.vscode/"

mkdir -p "${WORKING_DIR}/${APP_DIR}/"
cp "${TEMPLATE_PATH}/app/.dockerignore" "${WORKING_DIR}/${APP_DIR}/"
cp "${TEMPLATE_PATH}/app/Dockerfile" "${WORKING_DIR}/${APP_DIR}/"
cp "${TEMPLATE_PATH}/app/"*.* "${WORKING_DIR}/${APP_DIR}/"

mkdir -p "${WORKING_DIR}/${APP_DIR}/docker/"
cp "${TEMPLATE_PATH}/app/docker/"*.* "${WORKING_DIR}/${APP_DIR}/docker/"

mkdir -p "${WORKING_DIR}/${APP_DIR}/nginx/"
cp "${TEMPLATE_PATH}/app/nginx/"*.* "${WORKING_DIR}/${APP_DIR}/nginx/"

mkdir -p "${WORKING_DIR}/${APP_DIR}/src/"
cp "${TEMPLATE_PATH}/app/src/"*.* "${WORKING_DIR}/${APP_DIR}/src/"

mkdir -p "${WORKING_DIR}/${APP_DIR}/src/components/"
cp "${TEMPLATE_PATH}/app/src/components/"*.* "${WORKING_DIR}/${APP_DIR}/src/components/"

mkdir -p "${WORKING_DIR}/${APP_DIR}/src/components/overrides/"
cp "${TEMPLATE_PATH}/app/src/components/overrides/"*.* "${WORKING_DIR}/${APP_DIR}/src/components/overrides/"

mkdir -p "${WORKING_DIR}/${APP_DIR}/src/content/docs/"
cp "${TEMPLATE_PATH}/app/src/content/docs/sidebar.config.mjs" "${WORKING_DIR}/${APP_DIR}/src/content/docs/"

mkdir -p "${WORKING_DIR}/${APP_DIR}/src/styles/"
cp "${TEMPLATE_PATH}/app/src/styles/"*.* "${WORKING_DIR}/${APP_DIR}/src/styles/"

mkdir -p "${WORKING_DIR}/${APP_DIR}/src/utils/"
cp "${TEMPLATE_PATH}/app/src/utils/"*.* "${WORKING_DIR}/${APP_DIR}/src/utils/"

mkdir -p "${WORKING_DIR}/${APP_DIR}/test/"
cp -r "${TEMPLATE_PATH}/app/test/"* "${WORKING_DIR}/${APP_DIR}/test/"

mkdir -p "${WORKING_DIR}/scripts/"
cp "${TEMPLATE_PATH}/scripts/"*.* "${WORKING_DIR}/scripts/"

echo '✅ Copied template files to project.'

# ---

# Set template commit hash in project
COMMIT_HASH=$(git -C "${TEMPLATE_PATH}" rev-parse HEAD)
echo "${COMMIT_HASH}" > "${WORKING_DIR}/${APP_DIR}/.starlight-template"

# Git add template commit hash file
git_repo add "${APP_DIR}/.starlight-template"

# Commit if there are staged changes
if [ -n "$(git_repo diff --cached --name-only)" ]; then
	git_repo commit -m 'Set starlight template commit hash'
fi

echo "✅ Set template commit hash in project: '${COMMIT_HASH}'"

# ---

echo '👏 Done!'
echo '📝 Please review the changes and restore your custom files as necessary.'
