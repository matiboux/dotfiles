#!/bin/sh
# docker wrapper: injects AI tool credentials/config (Claude Code, Codex, GitHub CLI, GlitchTip CLI) into
# devcontainers started through `docker run|create` or `docker compose`.
set -eu

REAL_DOCKER="$(command -v docker)"

NL='
'

# The devcontainer workspace is always mounted at this path
WORKSPACE_TARGET="/workdir"

# ---------- Shared state ----------

# Filled by the tool sections below (newline-separated lists):
#   VOLUMES: "host:container" bind mounts
#   ENVS:    "NAME=value" environment variables
VOLUMES=""
ENVS=""

add_volume() { VOLUMES="${VOLUMES}${1}${NL}"; }
add_env() { ENVS="${ENVS}${1}${NL}"; }

# ---------- Helpers ----------

# Claude-style directory key for a path: every non-alphanumeric char -> "-"
path_key() {
	printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'
}

# ---------- Tool: Claude Code (vscode extension) ----------

CLAUDE_HOST_DIR="$HOME/.claude"        # your already-logged-in config
CLAUDE_CONTAINER_DIR="/opt/claude-shared"

setup_claude() {
	add_volume "${CLAUDE_HOST_DIR}:${CLAUDE_CONTAINER_DIR}"
	add_env "CLAUDE_CONFIG_DIR=${CLAUDE_CONTAINER_DIR}"
}

# Claude stores sessions/memory under projects/<cwd key>. Since the workspace
# is always /workdir, every project would share projects/-workdir. Overlay it
# with the project's own host dir (the one Claude uses when run locally), so
# sessions are per-project and shared with the host.
# Args: host path of the workspace source in $1
setup_claude_project() {
	scp_src="$1"
	case "$scp_src" in /*) ;; *) return 0 ;; esac
	scp_real="$(cd "$scp_src" 2>/dev/null && pwd -P)" || return 0
	scp_dir="${CLAUDE_HOST_DIR}/projects/$(path_key "$scp_real")"
	# Create as the user, otherwise docker would create a root-owned dir
	mkdir -p "$scp_dir" || return 0
	add_volume "${scp_dir}:${CLAUDE_CONTAINER_DIR}/projects/$(path_key "$WORKSPACE_TARGET")"
}

# ---------- Tool: OpenAI Codex (vscode extension) ----------

CODEX_HOST_DIR="${CODEX_HOME:-$HOME/.codex}"  # auth.json, config...
CODEX_CONTAINER_DIR="/opt/codex-shared"

setup_codex() {
	# Skip if absent, otherwise docker would create an empty root-owned dir
	[ -d "$CODEX_HOST_DIR" ] || return 0
	add_volume "${CODEX_HOST_DIR}:${CODEX_CONTAINER_DIR}"
	add_env "CODEX_HOME=${CODEX_CONTAINER_DIR}"
}

# ---------- Tool: GitHub CLI ----------

GH_HOST_DIR="${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}"  # hosts.yml (token)...
GH_CONTAINER_DIR="/opt/gh-shared"

setup_gh() {
	# Skip if absent, otherwise docker would create an empty root-owned dir
	[ -d "$GH_HOST_DIR" ] || return 0
	add_volume "${GH_HOST_DIR}:${GH_CONTAINER_DIR}"
	add_env "GH_CONFIG_DIR=${GH_CONTAINER_DIR}"
}

# ---------- Tool: GlitchTip CLI (bin/glitchtip) ----------

GLITCHTIP_HOST_DIR="${GLITCHTIP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/glitchtip}"  # per-host API keys
GLITCHTIP_CONTAINER_DIR="/opt/glitchtip-shared"

setup_glitchtip() {
	# Skip if absent, otherwise docker would create an empty root-owned dir
	[ -d "$GLITCHTIP_HOST_DIR" ] || return 0
	add_volume "${GLITCHTIP_HOST_DIR}:${GLITCHTIP_CONTAINER_DIR}:ro"
	add_env "GLITCHTIP_CONFIG_DIR=${GLITCHTIP_CONTAINER_DIR}"
}

# ---------- Collect everything to inject ----------

setup_claude
setup_codex
setup_gh
setup_glitchtip

# Tools that depend on the workspace source on the host.
# Args: host path of the workspace source in $1 (may be empty)
setup_workspace_tools() {
	if [ -n "$1" ]; then setup_claude_project "$1"; fi
}

# ---------- Workspace detection ----------

# Print the host source of a `docker run` volume spec ("src:target[:opts]")
# in $1 if it targets $WORKSPACE_TARGET
volume_workspace_source() {
	vw_rest="${1#*:}"
	if [ "${vw_rest%%:*}" = "$WORKSPACE_TARGET" ]; then printf '%s\n' "${1%%:*}"; fi
}

# Same for a --mount spec ("type=bind,source=...,target=...")
mount_workspace_source() {
	mw_list="$(printf '%s' "$1" | tr ',' '\n')"
	mw_tgt="$(printf '%s\n' "$mw_list" | sed -n 's/^\(target\|destination\|dst\)=//p' | head -n 1)"
	mw_src="$(printf '%s\n' "$mw_list" | sed -n 's/^\(source\|src\)=//p' | head -n 1)"
	if [ "$mw_tgt" = "$WORKSPACE_TARGET" ]; then printf '%s\n' "$mw_src"; fi
}

# Print the host workspace source found in `docker run` args
find_run_workspace() {
	fr_next=""
	for fr_a in "$@"; do
		case "$fr_next" in
			vol) volume_workspace_source "$fr_a"; fr_next=""; continue ;;
			mnt) mount_workspace_source "$fr_a"; fr_next=""; continue ;;
		esac
		case "$fr_a" in
			-v|--volume) fr_next=vol ;;
			--volume=*)  volume_workspace_source "${fr_a#--volume=}" ;;
			--mount)     fr_next=mnt ;;
			--mount=*)   mount_workspace_source "${fr_a#--mount=}" ;;
		esac
	done
}

# ---------- `docker run` / `docker create` ----------

handle_run() {
	run_sub="$1"; shift
	setup_workspace_tools "$(find_run_workspace "$@" | head -n 1)"

	# Prepend -v/-e options for every collected volume/env
	while IFS= read -r run_v; do
		if [ -n "$run_v" ]; then set -- -v "$run_v" "$@"; fi
	done <<EOF
$VOLUMES
EOF
	while IFS= read -r run_e; do
		if [ -n "$run_e" ]; then set -- -e "$run_e" "$@"; fi
	done <<EOF
$ENVS
EOF
	exec "$REAL_DOCKER" "$run_sub" "$@"
}

# ---------- `docker compose ...` ----------

# Run `docker compose -f <file>... config [flag]` quietly, tolerating failures
# Args: newline-separated list of -f files in $1, optional config flag in $2
compose_config() {
	cc_files="$1"; cc_flag="${2:-}"
	set --
	while IFS= read -r cc_f; do
		if [ -n "$cc_f" ]; then set -- "$@" -f "$cc_f"; fi
	done <<EOF
$cc_files
EOF
	"$REAL_DOCKER" compose "$@" config ${cc_flag:+"$cc_flag"} 2>/dev/null || true
}

# Print compose services of the given -f files
list_services() { compose_config "$1" --services; }

# Print the host source of the compose bind mount targeting $WORKSPACE_TARGET
find_compose_workspace() {
	compose_config "$1" | awk -v t="$WORKSPACE_TARGET" '
		$1 == "-" && $2 == "type:" { src = "" }
		$1 == "source:" { src = $2 }
		$1 == "target:" && $2 == t && src ~ /^\// { print src; exit }
	'
}

# Print a compose override file injecting volumes/envs into every service
# Args: newline-separated list of service names in $1
generate_compose_override() {
	echo "services:"
	while IFS= read -r go_svc; do
		[ -n "$go_svc" ] || continue
		echo "  ${go_svc}:"
		echo "    volumes:"
		while IFS= read -r go_v; do
			if [ -n "$go_v" ]; then echo "      - ${go_v}"; fi
		done <<EOF
$VOLUMES
EOF
		echo "    environment:"
		while IFS= read -r go_e; do
			if [ -n "$go_e" ]; then echo "      ${go_e%%=*}: ${go_e#*=}"; fi
		done <<EOF
$ENVS
EOF
	done <<EOF
$1
EOF
}

handle_compose() {
	files=""
	subcommand_pos=-1
	pos=0
	expect_file=0

	# Find -f files and the position of the first up/run/create/start
	for a in "$@"; do
		if [ "$expect_file" -eq 1 ]; then
			files="${files}${a}${NL}"
			expect_file=0
		else
			case "$a" in
				-f|--file) expect_file=1 ;;
				up|run|create|start)
					[ "$subcommand_pos" -eq -1 ] && subcommand_pos=$pos ;;
			esac
		fi
		pos=$((pos+1))
	done

	override_file=""
	if [ "$subcommand_pos" -ge 0 ] && [ -n "$files" ]; then
		# Ask real docker/compose which services this project actually has
		services="$(list_services "$files")"

		if [ -n "$services" ]; then
			setup_workspace_tools "$(find_compose_workspace "$files")"
			override_file="$(mktemp "${TMPDIR:-/tmp}/devcontainer-override-XXXXXX")"
			generate_compose_override "$services" > "$override_file"

			# Rebuild "$@", inserting -f <override> right before the subcommand
			i=0
			n=$#
			while [ "$i" -lt "$n" ]; do
				[ "$i" -eq "$subcommand_pos" ] && set -- "$@" -f "$override_file"
				set -- "$@" "$1"
				shift
				i=$((i+1))
			done
		fi
	fi

	status=0
	"$REAL_DOCKER" compose "$@" || status=$?
	[ -n "$override_file" ] && rm -f "$override_file"
	exit "$status"
}

# ---------- Dispatch ----------

case "${1:-}" in
	run|create) handle_run "$@" ;;
	compose)    shift; handle_compose "$@" ;;
	*)          exec "$REAL_DOCKER" "$@" ;;  # ps, logs, build, down, exec...
esac
