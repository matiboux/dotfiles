#!/usr/bin/env bash
set -euo pipefail

REAL_DOCKER="$(which docker)"

# Shared state, filled by the tool sections below:
#   VOLUMES: "host:container" bind mounts
#   ENVS:    "NAME=value" environment variables
VOLUMES=()
ENVS=()

# ---------- Claude Code (vscode extension) ----------
CLAUDE_HOST_DIR="$HOME/.claude"        # your already-logged-in config
CLAUDE_CONTAINER_DIR="/opt/claude-shared"

setup_claude() {
  VOLUMES+=("${CLAUDE_HOST_DIR}:${CLAUDE_CONTAINER_DIR}")
  ENVS+=("CLAUDE_CONFIG_DIR=${CLAUDE_CONTAINER_DIR}")
}

# ---------- OpenAI Codex (vscode extension) ----------
CODEX_HOST_DIR="${CODEX_HOME:-$HOME/.codex}"  # auth.json, config...
CODEX_CONTAINER_DIR="/opt/codex-shared"

setup_codex() {
  # Skip if absent, otherwise docker would create an empty root-owned dir
  [[ -d "$CODEX_HOST_DIR" ]] || return 0
  VOLUMES+=("${CODEX_HOST_DIR}:${CODEX_CONTAINER_DIR}")
  ENVS+=("CODEX_HOME=${CODEX_CONTAINER_DIR}")
}

# ---------- Credential propagation: collect everything to inject ----------
setup_claude
setup_codex

# ---------- `docker run` / `docker create` ----------
handle_run() {
  local sub="$1"; shift
  local inject=()
  local v e
  for v in "${VOLUMES[@]}"; do inject+=(-v "$v"); done
  for e in "${ENVS[@]}"; do inject+=(-e "$e"); done
  exec "$REAL_DOCKER" "$sub" "${inject[@]}" "$@"
}

# ---------- `docker compose ...` ----------

# Print a compose override file injecting volumes/envs into every service
# Args: list of service names
generate_compose_override() {
  local svc v e
  echo "services:"
  for svc in "$@"; do
    echo "  ${svc}:"
    echo "    volumes:"
    for v in "${VOLUMES[@]}"; do echo "      - ${v}"; done
    echo "    environment:"
    for e in "${ENVS[@]}"; do echo "      ${e%%=*}: ${e#*=}"; done
  done
}

handle_compose() {
  local compose_args=("$@")
  local files=() passthrough=()
  local subcommand="" subcommand_pos=-1
  local i=0 n=${#compose_args[@]} a

  while (( i < n )); do
    a="${compose_args[$i]}"
    case "$a" in
      -f|--file)
        files+=("${compose_args[$((i+1))]}")
        passthrough+=("$a" "${compose_args[$((i+1))]}")
        i=$((i+2))
        ;;
      up|run|create|start)
        if [[ -z "$subcommand" ]]; then
          subcommand="$a"
          subcommand_pos=${#passthrough[@]}
        fi
        passthrough+=("$a")
        i=$((i+1))
        ;;
      *)
        passthrough+=("$a")
        i=$((i+1))
        ;;
    esac
  done

  local override_file=""
  if [[ -n "$subcommand" && ${#files[@]} -gt 0 ]]; then
    local f_flags=() f
    for f in "${files[@]}"; do f_flags+=(-f "$f"); done

    # Ask real docker/compose which services this project actually has
    local services_raw services=()
    services_raw="$("$REAL_DOCKER" compose "${f_flags[@]}" config --services 2>/dev/null || true)"
    while IFS= read -r f; do
      [[ -n "$f" ]] && services+=("$f")
    done <<< "$services_raw"

    if (( ${#services[@]} > 0 )); then
      override_file="${TMPDIR:-/tmp}/devcontainer-override-$$-${RANDOM}.yml"
      generate_compose_override "${services[@]}" > "$override_file"

      local new_passthrough=() idx
      for idx in "${!passthrough[@]}"; do
        if [[ "$idx" -eq "$subcommand_pos" ]]; then
          new_passthrough+=(-f "$override_file")
        fi
        new_passthrough+=("${passthrough[$idx]}")
      done
      passthrough=("${new_passthrough[@]}")
    fi
  fi

  local status=0
  "$REAL_DOCKER" compose "${passthrough[@]}" || status=$?
  [[ -n "$override_file" ]] && rm -f "$override_file"
  exit "$status"
}

# ---------- Dispatch ----------
case "${1:-}" in
  run|create) handle_run "$@" ;;
  compose)    shift; handle_compose "$@" ;;
  *)          exec "$REAL_DOCKER" "$@" ;;  # ps, logs, build, down, exec...
esac
